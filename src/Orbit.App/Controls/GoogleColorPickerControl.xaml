<UserControl x:Class="Orbit.App.Controls.GoogleColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320" Background="#1E202B">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Orbit.App;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PickerMiniSwatch" TargetType="Button">
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#3D4252" BorderThickness="1.5"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#1E202B" BorderBrush="#353746" BorderThickness="1" CornerRadius="12" Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,10">
                <TextBlock Text="Color Picker" Foreground="{DynamicResource OrbitTextPrimaryBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button x:Name="BtnClosePicker" Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="{DynamicResource OrbitTextSecondaryBrush}" 
                        BorderThickness="0" FontSize="11" Cursor="Hand" Click="OnCloseClicked"/>
            </Grid>

            <!-- 1. Top Section: Large Preview Swatch + 2D Saturation/Value Canvas -->
            <Grid Height="140" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Solid Color Preview Swatch -->
                <Border x:Name="PreviewSwatch" Grid.Column="0" CornerRadius="8,0,0,8" Background="#FF7A1A" Margin="0,0,2,0">
                    <Grid>
                        <TextBlock Text="Preview" FontSize="10" FontWeight="SemiBold" Foreground="#88FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </Grid>
                </Border>

                <!-- Right: 2D Saturation / Value Gradient Canvas -->
                <Border Grid.Column="1" CornerRadius="0,8,8,0" ClipToBounds="True">
                    <Canvas x:Name="SvCanvas" Background="Red"
                            MouseLeftButtonDown="OnSvCanvasMouseDown"
                            MouseMove="OnSvCanvasMouseMove"
                            MouseLeftButtonUp="OnSvCanvasMouseUp">
                        <!-- Horizontal White-to-Transparent Gradient -->
                        <Rectangle Width="{Binding ActualWidth, ElementName=SvCanvas}" Height="{Binding ActualHeight, ElementName=SvCanvas}" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Vertical Transparent-to-Black Gradient -->
                        <Rectangle Width="{Binding ActualWidth, ElementName=SvCanvas}" Height="{Binding ActualHeight, ElementName=SvCanvas}" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#FF000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Draggable Circular Thumb Ring -->
                        <Ellipse x:Name="SvThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2" Fill="Transparent" IsHitTestVisible="False">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.8" Color="#000000"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                </Border>
            </Grid>

            <!-- 2. Rainbow Hue Slider (0° to 360°) -->
            <TextBlock Text="HUE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextSecondaryBrush}" Margin="0,0,0,4"/>
            <Border Height="16" CornerRadius="8" Margin="0,0,0,12" ClipToBounds="True">
                <Canvas x:Name="HueCanvas" 
                        MouseLeftButtonDown="OnHueCanvasMouseDown"
                        MouseMove="OnHueCanvasMouseMove"
                        MouseLeftButtonUp="OnHueCanvasMouseUp">
                    <!-- Rainbow Spectrum -->
                    <Rectangle Width="{Binding ActualWidth, ElementName=HueCanvas}" Height="{Binding ActualHeight, ElementName=HueCanvas}" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF0000" Offset="0.0"/>
                                <GradientStop Color="#FFFF00" Offset="0.17"/>
                                <GradientStop Color="#00FF00" Offset="0.33"/>
                                <GradientStop Color="#00FFFF" Offset="0.50"/>
                                <GradientStop Color="#0000FF" Offset="0.67"/>
                                <GradientStop Color="#FF00FF" Offset="0.83"/>
                                <GradientStop Color="#FF0000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Draggable Hue Thumb -->
                    <Ellipse x:Name="HueThumb" Width="16" Height="16" Stroke="White" StrokeThickness="2.5" Fill="#FF7A1A" IsHitTestVisible="False">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.8" Color="#000000"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Border>

            <!-- 3. HEX Input & Copy -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="HEX" Foreground="{DynamicResource OrbitTextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <TextBox x:Name="TbHex" Grid.Column="1" Height="28" Background="#16171E" Foreground="White" 
                         BorderBrush="#353746" BorderThickness="1" Padding="8,4" FontSize="12" FontWeight="SemiBold"
                         Text="#FF7A1A" TextChanged="OnTbHexChanged"/>

                <Button x:Name="BtnCopyHex" Grid.Column="2" Content="📋 Copy" Height="28" Margin="6,0,0,0" Padding="8,0" 
                        Background="#262836" Foreground="{DynamicResource OrbitTextSecondaryBrush}" BorderThickness="0" Cursor="Hand"
                        Click="OnCopyHexClicked">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                </Button>
            </Grid>

            <!-- 4. Readouts: RGB, HSV, CMYK, HSL -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- RGB -->
                <Border Grid.Row="0" Grid.Column="0" Background="#16171E" BorderBrush="#2A2D3C" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,3,4">
                    <StackPanel>
                        <TextBlock Text="RGB" FontSize="9" FontWeight="Bold" Foreground="#8892B0"/>
                        <TextBlock x:Name="TxtRgbVal" Text="255, 122, 26" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- HSV -->
                <Border Grid.Row="0" Grid.Column="1" Background="#16171E" BorderBrush="#2A2D3C" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="3,0,0,4">
                    <StackPanel>
                        <TextBlock Text="HSV" FontSize="9" FontWeight="Bold" Foreground="#8892B0"/>
                        <TextBlock x:Name="TxtHsvVal" Text="25°, 90%, 100%" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- CMYK -->
                <Border Grid.Row="1" Grid.Column="0" Background="#16171E" BorderBrush="#2A2D3C" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,3,0">
                    <StackPanel>
                        <TextBlock Text="CMYK" FontSize="9" FontWeight="Bold" Foreground="#8892B0"/>
                        <TextBlock x:Name="TxtCmykVal" Text="0%, 52%, 90%, 0%" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- HSL -->
                <Border Grid.Row="1" Grid.Column="1" Background="#16171E" BorderBrush="#2A2D3C" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="3,0,0,0">
                    <StackPanel>
                        <TextBlock Text="HSL" FontSize="9" FontWeight="Bold" Foreground="#8892B0"/>
                        <TextBlock x:Name="TxtHslVal" Text="25°, 100%, 55%" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 5. Quick Color Presets -->
            <TextBlock Text="QUICK PALETTE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextSecondaryBrush}" Margin="0,0,0,4"/>
            <WrapPanel Margin="0,0,0,12" HorizontalAlignment="Center">
                <Button Background="#EF4444" Style="{StaticResource PickerMiniSwatch}" Click="OnQuickSwatchClicked" ToolTip="Red"/>
                <Button Background="#F97316" Style="{StaticResource PickerMiniSwatch}" Click="OnQuickSwatchClicked" ToolTip="Orange"/>
                <Button Background="#FF7A1A" Style="{StaticResource PickerMiniSwatch}" Click="OnQuickSwatchClicked" ToolTip="Orbit Orange"/>
                <Button Background="#FACC15" Style="{StaticResource PickerMiniSwatch}" Click="OnQuickSwatchClicked" ToolTip="Yellow"/>
                <Button Background="#10B981" Style="{StaticResource PickerMiniSwatch}" Click="OnQuickSwatchClicked" ToolTip="Green"/>
                <Button Background="#06B6D4" Style="{StaticResource PickerMiniSwatch}" Click="OnQuickSwatchClicked" ToolTip="Cyan"/>
                <Button Background="#3B82F6" Style="{StaticResource PickerMiniSwatch}" Click="OnQuickSwatchClicked" ToolTip="Blue"/>
                <Button Background="#8B5CF6" Style="{StaticResource PickerMiniSwatch}" Click="OnQuickSwatchClicked" ToolTip="Purple"/>
                <Button Background="#EC4899" Style="{StaticResource PickerMiniSwatch}" Click="OnQuickSwatchClicked" ToolTip="Pink"/>
                <Button Background="#FFFFFF" Style="{StaticResource PickerMiniSwatch}" Click="OnQuickSwatchClicked" ToolTip="White"/>
                <Button Background="#64748B" Style="{StaticResource PickerMiniSwatch}" Click="OnQuickSwatchClicked" ToolTip="Gray"/>
                <Button Background="#000000" Style="{StaticResource PickerMiniSwatch}" Click="OnQuickSwatchClicked" ToolTip="Black"/>
            </WrapPanel>

            <!-- Apply Button -->
            <Button Content="Apply Color" Height="32" Background="#FF7A1A" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Click="OnApplyClicked">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
