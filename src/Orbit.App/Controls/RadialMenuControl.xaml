<UserControl x:Class="Orbit.App.Controls.RadialMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="540" Height="540"
             Background="Transparent">
    <Grid Width="540" Height="540">
        <!-- Outer Glow Canvas -->
        <Canvas x:Name="OuterGlowCanvas" Width="540" Height="540" IsHitTestVisible="False" />

        <!-- Radial Action Wedges (Level 2) -->
        <Canvas x:Name="ActionWedgesCanvas" Width="540" Height="540" />

        <!-- Radial Category Ring (Level 1) -->
        <Canvas x:Name="CategoryWedgesCanvas" Width="540" Height="540" />

        <!-- Central Hub (Level 0) -->
        <Grid Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Ambient Glow -->
            <Ellipse Width="120" Height="120" Fill="#40FF6A00">
                <Ellipse.Effect>
                    <BlurEffect Radius="24" />
                </Ellipse.Effect>
            </Ellipse>

            <!-- Inner Circle Base -->
            <Ellipse x:Name="CentralHubCircle" Width="96" Height="96" 
                     Fill="#251812" Stroke="#FF7A1A" StrokeThickness="2.5" />

            <!-- Hub Content (Cancel or Active Category) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="TxtHubIcon" Text="✕" 
                           Foreground="#FFA552" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock x:Name="TxtHubLabel" Text="Cancel" 
                           Foreground="#E0E0E0" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Hover Info Card (Top Right / Bottom Right) -->
        <Border x:Name="HoverInfoCard" 
                Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,20,20,0"
                Background="#EE1A1B24" BorderBrush="#FF7A1A" BorderThickness="1.5"
                CornerRadius="10" Padding="14,10"
                MaxWidth="240">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="Black" Opacity="0.6"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="TxtHoverTitle" Text="Convert to JPG" 
                           Foreground="#FF8C00" FontSize="13" FontWeight="Bold" />
                <TextBlock x:Name="TxtHoverDescription" Text="High quality image optimized for sharing" 
                           Foreground="#CCCCCC" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Drag File Summary Badge (Top Left) -->
        <Border x:Name="FileBadge"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="20,20,0,0"
                Background="#E014151C" BorderBrush="#353745" BorderThickness="1"
                CornerRadius="8" Padding="10,6" MaxWidth="220">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📄" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFileBadgeName" Text="screenshot.png" 
                               Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxWidth="160" />
                    <TextBlock x:Name="TxtFileBadgeDetails" Text="PNG • 1920 × 1080" 
                               Foreground="#8E92A8" FontSize="10" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
