<Window x:Class="Orbit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit — Ambient Radial Action Canvas"
        Height="620" Width="960"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource OrbitBackgroundBrush}">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource OrbitSurfaceBrush}" CornerRadius="12" Padding="20,16" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource OrbitPrimaryBrush}" Margin="0,0,12,0">
                            <TextBlock Text="◎" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <TextBlock Text="ORBIT" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border Background="#1E293B" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v0.1.0-alpha" Foreground="{StaticResource OrbitAccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Context-aware radial file action canvas triggered by drag &amp; Shift gestures." 
                               Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="13" Margin="44,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#132E27" BorderBrush="#059669" BorderThickness="1" CornerRadius="20" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tray Listener Active" Foreground="#34D399" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnMinimizeToTray" Content="Minimize to Tray" Padding="12,6" 
                            Background="{StaticResource OrbitSurfaceHoverBrush}" Foreground="{StaticResource OrbitTextPrimaryBrush}" 
                            BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1" Cursor="Hand" Click="OnMinimizeToTrayClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Drop target and Capabilities test pad -->
        <Grid Grid.Row="1" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <!-- Interactive Drop Zone -->
            <Border Grid.Column="0" Margin="0,0,12,0" Background="{StaticResource OrbitSurfaceBrush}" CornerRadius="12" 
                    BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1" AllowDrop="True"
                    Drop="OnDropFiles" DragOver="OnDragOverFiles">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Interactive Test Canvas" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Drag and drop files here to inspect identified file identity and triggered Orbit radial capabilities." 
                                   Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" Margin="0,2,0,12"/>
                    </StackPanel>

                    <!-- Drop Target Indicator -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="2" 
                            CornerRadius="10" Background="#12151E" VerticalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="✦" FontSize="36" Foreground="{StaticResource OrbitPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Drop any file(s) here" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="15" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="Supports images, documents, archives, videos, audio, data &amp; code" 
                                       Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Drop Result Summary -->
                    <TextBlock x:Name="TxtDropSummary" Grid.Row="2" Text="Awaiting file drop..." 
                               Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- Capabilities & Registry Info Side Panel -->
            <Border Grid.Column="1" Background="{StaticResource OrbitSurfaceBrush}" CornerRadius="12" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Registered Operations" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtOperationsCount" Text="Loading engine registry..." Foreground="{StaticResource OrbitAccentBrush}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LstResolvedOperations">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource OrbitSurfaceHoverBrush}" CornerRadius="6" Margin="0,0,0,6" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontWeight="Medium" FontSize="12"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#282E42" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource OrbitAccentBrush}" FontSize="10"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer / Gesture Tip -->
        <Border Grid.Row="2" Background="{StaticResource OrbitSurfaceBrush}" CornerRadius="8" Padding="14,10" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Tip: In production mode, Orbit runs invisibly in your system tray. Hold SHIFT while dragging any file to summon the radial canvas under your cursor." 
                           Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Orbit Engine: SixLabors.ImageSharp + SharpCompress" 
                           Foreground="{StaticResource OrbitAccentBrush}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
