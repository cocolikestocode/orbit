<Window x:Class="Orbit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit — Ambient Radial Action Canvas"
        Height="780" Width="1160"
        MinHeight="620" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource OrbitBackgroundBrush}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Dedicated Workspaces Row (5 Studios) -->
            <RowDefinition Height="Auto"/>
            <!-- Main Body: Drop target and Capabilities test pad -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource OrbitSurfaceBrush}" CornerRadius="12" Padding="20,14" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource OrbitPrimaryBrush}" Margin="0,0,12,0">
                            <TextBlock Text="◎" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <TextBlock Text="ORBIT" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border Background="#2C2F3E" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v0.1.0-alpha" Foreground="{StaticResource OrbitAccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Context-aware radial file action canvas triggered by drag &amp; Shift gestures." 
                               Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="13" Margin="44,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#132E27" BorderBrush="#059669" BorderThickness="1" CornerRadius="20" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tray Listener Active" Foreground="#34D399" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnHeaderSettings" Content="⚙ Settings" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,8,0" Click="OnOpenSettingsClicked"/>
                    <Button x:Name="BtnMinimizeToTray" Content="Minimize to Tray" Style="{StaticResource OrbitSecondaryButtonStyle}" Click="OnMinimizeToTrayClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DEDICATED WORKSPACES ACTION CARDS (ALL 5 STUDIOS) -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Image Studio -->
            <Border Grid.Column="0" Background="{StaticResource OrbitSurfaceBrush}" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="24" Height="24" CornerRadius="6" Background="#2C2F3E" Margin="0,0,8,0">
                            <TextBlock Text="✎" Foreground="{StaticResource OrbitAccentBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Image Studio" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Annotate, tune, crop, blur, redact &amp; watermark." Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button x:Name="BtnLaunchAnnotator" Grid.Row="2" Content="Launch Studio" Style="{StaticResource OrbitAccentButtonStyle}" HorizontalAlignment="Stretch" Padding="8,5" FontSize="11" Click="OnOpenAnnotatorClicked"/>
                </Grid>
            </Border>

            <!-- Card 2: PDF Studio -->
            <Border Grid.Column="1" Background="{StaticResource OrbitSurfaceBrush}" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="3,0,3,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="24" Height="24" CornerRadius="6" Background="#2C2F3E" Margin="0,0,8,0">
                            <TextBlock Text="📄" Foreground="{StaticResource OrbitAccentBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="PDF Studio" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Viewer, markup, reorder, protect &amp; merge." Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button x:Name="BtnLaunchPdfStudio" Grid.Row="2" Content="Launch PDF" Style="{StaticResource OrbitAccentButtonStyle}" HorizontalAlignment="Stretch" Padding="8,5" FontSize="11" Click="OnOpenPdfStudioClicked"/>
                </Grid>
            </Border>

            <!-- Card 3: Compressor Studio -->
            <Border Grid.Column="2" Background="{StaticResource OrbitSurfaceBrush}" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="3,0,3,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="24" Height="24" CornerRadius="6" Background="#2C2F3E" Margin="0,0,8,0">
                            <TextBlock Text="🗜" Foreground="{StaticResource OrbitAccentBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Compressor" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Images, videos, audio, PDF &amp; archives." Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button x:Name="BtnLaunchCompressor" Grid.Row="2" Content="Launch Optimizer" Style="{StaticResource OrbitAccentButtonStyle}" HorizontalAlignment="Stretch" Padding="8,5" FontSize="11" Click="OnOpenCompressorClicked"/>
                </Grid>
            </Border>

            <!-- Card 4: Batch Operations -->
            <Border Grid.Column="3" Background="{StaticResource OrbitSurfaceBrush}" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="3,0,3,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="24" Height="24" CornerRadius="6" Background="#2C2F3E" Margin="0,0,8,0">
                            <TextBlock Text="⚡" Foreground="{StaticResource OrbitAccentBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Batch Ops" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Queue processing with live progress tracking." Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button x:Name="BtnLaunchBatchOps" Grid.Row="2" Content="Launch Batch" Style="{StaticResource OrbitAccentButtonStyle}" HorizontalAlignment="Stretch" Padding="8,5" FontSize="11" Click="OnOpenBatchOperationsClicked"/>
                </Grid>
            </Border>

            <!-- Card 5: Settings & Customization -->
            <Border Grid.Column="4" Background="{StaticResource OrbitSurfaceBrush}" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="24" Height="24" CornerRadius="6" Background="#2C2F3E" Margin="0,0,8,0">
                            <TextBlock Text="⚙" Foreground="{StaticResource OrbitAccentBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Settings" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Modifier keys, radial hotkeys &amp; themes." Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button x:Name="BtnLaunchSettings" Grid.Row="2" Content="Configure" Style="{StaticResource OrbitSecondaryButtonStyle}" HorizontalAlignment="Stretch" Padding="8,5" FontSize="11" Click="OnOpenSettingsClicked"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Main Body: Drop target and Capabilities test pad -->
        <Grid Grid.Row="2" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <!-- Interactive Drop Zone & Radial Wheel Summon Pad -->
            <Border Grid.Column="0" Margin="0,0,10,0" Background="{StaticResource OrbitSurfaceBrush}" CornerRadius="12" 
                    BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1" AllowDrop="True"
                    Drop="OnDropFiles" DragOver="OnDragOverFiles">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Interactive Test Canvas" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Drop any file(s) here or browse to inspect contextual operations &amp; test the radial menu." 
                                       Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Content="📂 Browse File(s)..." HorizontalAlignment="Right" Style="{StaticResource OrbitSecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="OnBrowseFilesClicked"/>
                    </Grid>

                    <!-- Drop Target Indicator -->
                    <Border x:Name="DropIndicatorBorder" Grid.Row="1" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="2" 
                            CornerRadius="10" Background="#12151E" VerticalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="✦" FontSize="36" Foreground="{StaticResource OrbitPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Drop any file(s) here" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="15" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock Text="Supports images, documents, archives, videos, audio, data &amp; code" 
                                       Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,14"/>
                            <Button Content="Select Test File" Style="{StaticResource OrbitAccentButtonStyle}" Padding="14,6" FontSize="12" HorizontalAlignment="Center" Click="OnBrowseFilesClicked"/>
                        </StackPanel>
                    </Border>

                    <!-- Drop Result Summary & Workspace Action Shortcuts -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock x:Name="TxtDropSummary" Text="Awaiting file drop..." 
                                   Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                        
                        <WrapPanel x:Name="DropActionButtons" Margin="0,10,0,0" Visibility="Collapsed">
                            <!-- Direct Radial Summon Button -->
                            <Button x:Name="BtnDroppedSummonWheel" Content="◎ Summon Radial Wheel" Style="{StaticResource OrbitAccentButtonStyle}" Margin="0,0,8,6" Padding="12,6" FontSize="11" FontWeight="Bold" Click="OnDroppedSummonWheelClicked"/>
                            <Button x:Name="BtnDroppedOpenAnnotator" Content="✎ Open in Image Studio" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,8,6" Padding="10,6" FontSize="11" Click="OnDroppedOpenAnnotatorClicked"/>
                            <Button x:Name="BtnDroppedOpenPdfStudio" Content="📄 Open in PDF Studio" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,8,6" Padding="10,6" FontSize="11" Click="OnDroppedOpenPdfClicked"/>
                            <Button x:Name="BtnDroppedOpenCompressor" Content="🗜 Open in Compressor" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,8,6" Padding="10,6" FontSize="11" Click="OnDroppedOpenCompressorClicked"/>
                            <Button x:Name="BtnDroppedOpenBatch" Content="⚡ Open in Batch Ops" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,8,6" Padding="10,6" FontSize="11" Click="OnDroppedOpenBatchClicked"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Capabilities & Operations Execution Panel -->
            <Border Grid.Column="1" Background="{StaticResource OrbitSurfaceBrush}" CornerRadius="12" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Panel Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Contextual Operations" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtOperationsCount" Text="Loading engine registry..." Foreground="{StaticResource OrbitAccentBrush}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Real-Time Search Box -->
                    <Border Grid.Row="1" Background="#161822" BorderBrush="#353746" BorderThickness="1" CornerRadius="6" Height="32" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="12" Foreground="{DynamicResource OrbitTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSearchOps" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" 
                                     VerticalContentAlignment="Center" FontSize="12" Padding="2,0" TextChanged="OnSearchOpsTextChanged"/>
                        </Grid>
                    </Border>

                    <!-- Operations List with Direct Execution Buttons -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LstResolvedOperations">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource OrbitSurfaceHoverBrush}" BorderBrush="#2D3040" BorderThickness="1" CornerRadius="8" Margin="0,0,0,6" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left Info -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Category Badge -->
                                            <Border Grid.Column="1" Background="#282E42" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource OrbitAccentBrush}" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Direct Run Button -->
                                            <Button Grid.Column="2" Content="Run ▶" Width="55" Height="26" Background="#FF7A1A" Foreground="White" 
                                                    FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                                                    Tag="{Binding}" Click="OnRunOperationClicked">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer / Gesture Tip -->
        <Border Grid.Row="3" Background="{StaticResource OrbitSurfaceBrush}" CornerRadius="8" Padding="14,10" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Tip: In production mode, Orbit runs invisibly in your system tray. Hold SHIFT while dragging any file to summon the radial canvas under your cursor." 
                           Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Orbit Engines: SixLabors.ImageSharp + SharpCompress + PdfSharpCore + SkiaSharp" 
                           Foreground="{StaticResource OrbitAccentBrush}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
