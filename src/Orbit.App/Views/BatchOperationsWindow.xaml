<Window x:Class="Orbit.App.Views.BatchOperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit — Batch Operations"
        Height="700" Width="1020"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource OrbitBackgroundBrush}">

    <Window.Resources>
        <!-- Custom Progress Bar Style -->
        <Style x:Key="OrbitProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="#1E202B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" 
                                        Background="{StaticResource OrbitAccentBrush}" 
                                        CornerRadius="3" 
                                        HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status Pill Style -->
        <Style x:Key="StatusPillBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Aggregate Progress Summary Card -->
            <RowDefinition Height="Auto"/>
            <!-- File Queue List -->
            <RowDefinition Height="*"/>
            <!-- Bottom Action Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" Background="{StaticResource OrbitSurfaceBrush}" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title & Subheader -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource OrbitAccentBrush}" Margin="0,0,10,0">
                            <TextBlock Text="⚡" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Batch Operations" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border x:Name="BadgeFileCount" Background="#2C2F3E" CornerRadius="12" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtQueueCountBadge" Text="0 files" Foreground="{StaticResource OrbitAccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtBatchSubheader" Text="No files queued • Select an operation and add files to begin" 
                               Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" Margin="40,3,0,0"/>
                </StackPanel>

                <!-- Header Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Target:" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbTargetOperation" Width="180" Height="32" 
                              Style="{StaticResource OrbitComboBoxStyle}" Margin="0,0,10,0"
                              SelectionChanged="OnTargetOperationSelectionChanged"/>
                    <Button Content="＋ Add Files..." Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,8,0" Click="OnAddFilesClicked"/>
                    <Button Content="Clear" Style="{StaticResource OrbitSecondaryButtonStyle}" Click="OnClearQueueClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- OVERALL PROGRESS SUMMARY -->
        <Border Grid.Row="1" Background="#1B1D26" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock x:Name="TxtOverallProgress" Text="Overall Progress: Idle" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtCompletedCount" Text=" (0 of 0 files completed)" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtElapsedTime" Grid.Column="1" Text="Elapsed: 00:00" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12"/>
                </Grid>

                <ProgressBar x:Name="OverallProgressBar" Grid.Row="1" Height="8" Style="{StaticResource OrbitProgressBarStyle}" Value="0" Maximum="100"/>
            </Grid>
        </Border>

        <!-- FILE QUEUE LIST (CENTER) -->
        <Grid Grid.Row="2" Margin="20,16,20,16" AllowDrop="True" Drop="OnFileQueueDrop" DragOver="OnFileQueueDragOver">
            <!-- Empty state when list has 0 items -->
            <Border x:Name="EmptyQueueBorder" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="2" 
                    CornerRadius="12" Background="#13141B" Padding="40" VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource OrbitAccentSubtleBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="📂" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Drop multiple files here to start a batch" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Supports images, documents, archives, audio, video and code files." 
                               Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,16"/>
                    <Button Content="Select Files..." Style="{StaticResource OrbitAccentButtonStyle}" HorizontalAlignment="Center" Click="OnAddFilesClicked"/>
                </StackPanel>
            </Border>

            <!-- Scrollable List of Files -->
            <ScrollViewer x:Name="FileQueueScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <ItemsControl x:Name="FileQueueItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource OrbitSurfaceBrush}" 
                                    BorderBrush="{StaticResource OrbitBorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Margin="0,0,0,8" 
                                    Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- File Icon -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Name & Info -->
                                        <ColumnDefinition Width="2*"/>
                                        <!-- Dimensions / File Size -->
                                        <ColumnDefinition Width="1.2*"/>
                                        <!-- Progress Bar & Status -->
                                        <ColumnDefinition Width="2*"/>
                                        <!-- Remove Button -->
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- File Icon Glyph -->
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6" Background="#2C2F3E" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Glyph}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name and Path -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FilePath}" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Dimensions & Size -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                        <TextBlock Text="{Binding Dimensions}" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding FileSizeText}" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Progress & Status Pill -->
                                    <Grid Grid.Column="3" VerticalAlignment="Center" Margin="10,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <ProgressBar Height="6" Style="{StaticResource OrbitProgressBarStyle}" Value="{Binding Progress}" Maximum="100"/>
                                        </Grid>

                                        <Border Grid.Row="1" HorizontalAlignment="Left" CornerRadius="8" Padding="8,2" BorderThickness="1"
                                                Background="{Binding StatusBadgeBackground}" BorderBrush="{Binding StatusBadgeBorder}">
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBadgeForeground}" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Remove Button -->
                                    <Button Grid.Column="4" Content="✕" ToolTip="Remove from batch" 
                                            Style="{StaticResource OrbitSecondaryButtonStyle}" 
                                            Padding="8,4" FontSize="11" Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Click="OnRemoveItemClicked"
                                            Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- BOTTOM ACTION BAR -->
        <Border Grid.Row="3" Background="{StaticResource OrbitSurfaceBrush}" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Checkbox & Destination Picker -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Start / Pause / Cancel Buttons -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Options -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Keep original files -->
                    <CheckBox x:Name="ChkKeepOriginal" Content="Keep original files" IsChecked="True" 
                              Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" Margin="0,0,24,0" VerticalAlignment="Center"/>

                    <!-- Output Destination -->
                    <TextBlock Text="Destination:" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbDestination" Width="170" Height="30" Style="{StaticResource OrbitComboBoxStyle}" 
                              SelectionChanged="OnDestinationSelectionChanged">
                        <ComboBoxItem Content="Same folder as original" IsSelected="True"/>
                        <ComboBoxItem Content="Custom folder..."/>
                    </ComboBox>

                    <Button x:Name="BtnBrowseCustomFolder" Content="📁 Browse..." Style="{StaticResource OrbitSecondaryButtonStyle}" 
                            Padding="10,5" Margin="8,0,0,0" Visibility="Collapsed" Click="OnBrowseCustomFolderClicked"/>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOpenOutputFolder" Content="📂 Open Folder" Style="{StaticResource OrbitSecondaryButtonStyle}" 
                            Margin="0,0,10,0" Visibility="Collapsed" Click="OnOpenOutputFolderClicked"/>
                    <Button x:Name="BtnCancelBatch" Content="Cancel" Style="{StaticResource OrbitSecondaryButtonStyle}" 
                            Margin="0,0,10,0" Click="OnCancelBatchClicked"/>
                    <Button x:Name="BtnStartBatch" Content="▶ Start Batch" Style="{StaticResource OrbitAccentButtonStyle}" 
                            Padding="20,8" Click="OnStartBatchClicked"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
