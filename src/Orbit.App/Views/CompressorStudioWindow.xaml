<Window x:Class="Orbit.App.Views.CompressorStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit — Compression Studio"
        Height="780" Width="1100"
        MinHeight="580" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource OrbitBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Orbit.App;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PresetChipStyle" TargetType="RadioButton">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Background" Value="#232530"/>
                <Setter Property="Foreground" Value="{DynamicResource OrbitTextSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="#353746"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2A1E14"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7A1A"/>
                                    <Setter Property="Foreground" Value="#FF7A1A"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7A1A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content Area (Preview + Controls) -->
            <RowDefinition Height="*"/>
            <!-- Action Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#16171E" BorderBrush="#2D303E" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & File Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1C2E24" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Orbit Compression Studio" Foreground="{DynamicResource OrbitTextPrimaryBrush}" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtFileName" Text="file_to_compress.png" Foreground="{DynamicResource OrbitTextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Savings Badge Card -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="#13241B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="20" Padding="16,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtOriginalSize" Text="4.8 MB" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text=" ➔ " Foreground="#10B981" FontSize="14" FontWeight="Bold" Margin="8,0"/>
                        <TextBlock x:Name="TxtEstimatedSize" Text="1.2 MB" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        <Border Background="#10B981" CornerRadius="10" Padding="8,2" Margin="12,0,0,0">
                            <TextBlock x:Name="TxtSavingsPercent" Text="-75% SAVED" Foreground="#0B1E13" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Right: Format Pill -->
                <Border Grid.Column="2" Background="#232530" BorderBrush="#353746" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFormatBadge" Text="IMAGE • PNG" Foreground="{DynamicResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN SPLIT (PREVIEW + COMPRESSION CONTROLS) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Visual Preview Area -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <!-- Tuning Controls Panel -->
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Preview Card -->
            <Grid Grid.Column="0" Background="#101116">
                <Border Margin="24" Background="#16171E" BorderBrush="#2D303E" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                    <Grid>
                        <!-- Visual Image Preview -->
                        <ScrollViewer x:Name="SvPreview" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image x:Name="ImgPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"/>
                        </ScrollViewer>

                        <!-- Media Info Card (for PDFs/Videos/Archives) -->
                        <Border x:Name="PnlMediaInfo" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#20222C" BorderBrush="#353746" BorderThickness="1" CornerRadius="12" Padding="28">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtMediaGlyph" Text="📄" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock x:Name="TxtMediaTitle" Text="Document Details" Foreground="{DynamicResource OrbitTextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtMediaDetails" Text="Pages: 12 • Resolution: 300 DPI" Foreground="{DynamicResource OrbitTextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#20222C"/>

            <!-- Tuning Controls Panel -->
            <Border Grid.Column="2" Background="#16171E" BorderBrush="#2D303E" BorderThickness="1,0,0,0" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Presets Section -->
                        <TextBlock Text="COMPRESSION PRESET" Foreground="{DynamicResource OrbitTextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                        <WrapPanel Margin="0,0,0,18">
                            <RadioButton Style="{StaticResource PresetChipStyle}" Content="Balanced" IsChecked="True" Checked="OnPresetBalancedChecked"/>
                            <RadioButton Style="{StaticResource PresetChipStyle}" Content="Max Space" Checked="OnPresetMaxChecked"/>
                            <RadioButton Style="{StaticResource PresetChipStyle}" Content="High Quality" Checked="OnPresetHighChecked"/>
                            <RadioButton Style="{StaticResource PresetChipStyle}" Content="Lossless" Checked="OnPresetLosslessChecked" Margin="0,8,8,0"/>
                        </WrapPanel>

                        <Rectangle Height="1" Fill="#262834" Margin="0,0,0,18"/>

                        <!-- Quality Slider Section -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="QUALITY / FIDELITY" Foreground="{DynamicResource OrbitTextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtQualityValue" Text="75%" HorizontalAlignment="Right" Foreground="#FF7A1A" FontSize="13" FontWeight="Bold"/>
                        </Grid>
                        <Slider x:Name="SliderQuality" Minimum="10" Maximum="100" Value="75" SmallChange="5" LargeChange="10" 
                                ValueChanged="OnQualityChanged" Margin="0,0,0,18"/>

                        <!-- Downscale / Resize Section -->
                        <TextBlock Text="RESOLUTION DOWNSCALE" Foreground="{DynamicResource OrbitTextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                        <ComboBox x:Name="CbResolution" Height="36" Style="{StaticResource OrbitComboBoxStyle}"
                                  SelectedIndex="0" SelectionChanged="OnResolutionChanged" Margin="0,0,0,18">
                            <ComboBoxItem Content="Keep 100% Original Resolution"/>
                            <ComboBoxItem Content="Downscale to 75%"/>
                            <ComboBoxItem Content="Downscale to 50% (Fast &amp; Small)"/>
                            <ComboBoxItem Content="Downscale to Max 1080p FHD"/>
                            <ComboBoxItem Content="Downscale to Max 720p HD"/>
                        </ComboBox>

                        <!-- Convert Format Section -->
                        <TextBlock Text="CONVERT FORMAT ON COMPRESS" Foreground="{DynamicResource OrbitTextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                        <ComboBox x:Name="CbFormat" Height="36" Style="{StaticResource OrbitComboBoxStyle}"
                                  SelectedIndex="0" SelectionChanged="OnFormatChanged" Margin="0,0,0,18">
                            <ComboBoxItem Content="Preserve Original Format"/>
                            <ComboBoxItem Content="Convert to WebP (Recommended, ~80% Smaller)"/>
                            <ComboBoxItem Content="Convert to JPEG"/>
                            <ComboBoxItem Content="Convert to PNG (Lossless)"/>
                        </ComboBox>

                        <!-- Privacy / Metadata Checkbox -->
                        <CheckBox x:Name="ChkStripMetadata" Content="Strip EXIF metadata (Camera, GPS, Timestamps)" 
                                  IsChecked="True" Foreground="{DynamicResource OrbitTextPrimaryBrush}" FontSize="12" 
                                  Checked="OnOptionChanged" Unchecked="OnOptionChanged" Margin="0,0,0,10"/>

                        <!-- Smooth Optimization Checkbox -->
                        <CheckBox x:Name="ChkOptimizePalette" Content="Lossless color palette &amp; chunk compression" 
                                  IsChecked="True" Foreground="{DynamicResource OrbitTextPrimaryBrush}" FontSize="12" 
                                  Checked="OnOptionChanged" Unchecked="OnOptionChanged" Margin="0,0,0,18"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ACTION FOOTER BAR -->
        <Border Grid.Row="2" Background="#16171E" BorderBrush="#2D303E" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status & Progress -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="Ready to compress" Foreground="{DynamicResource OrbitTextSecondaryBrush}" FontSize="12"/>
                    <ProgressBar x:Name="PbCompress" Height="4" Maximum="100" Value="0" Visibility="Collapsed" Background="#232530" Foreground="#FF7A1A" BorderThickness="0" Margin="0,6,24,0"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Save As..." Height="38" Padding="16,0" Background="#232530" Foreground="{DynamicResource OrbitTextSecondaryBrush}" BorderBrush="#353746" BorderThickness="1" Cursor="Hand" Click="OnSaveAsClicked" Margin="0,0,10,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Button x:Name="BtnCompress" Content="⚡ Compress Now" Width="150" Height="38" Background="#FF7A1A" Foreground="White" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="OnCompressClicked">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
