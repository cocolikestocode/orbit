<Window x:Class="Orbit.App.Views.ImageAnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit — Image Studio &amp; Annotator"
        Height="820" Width="1240"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource OrbitBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Orbit.App;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Tool Button Style -->
            <Style x:Key="ToolButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource OrbitTextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OrbitSurfaceHoverBrush}" />
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource OrbitBorderBrush}" />
                                </Trigger>
                                <Trigger Property="Tag" Value="Active">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OrbitAccentBrush}" />
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FFA552" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Mini Color Swatch Style -->
            <Style x:Key="ColorSwatchStyle" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="12" 
                                    BorderBrush="#454A5C" 
                                    BorderThickness="1.5">
                                <Ellipse x:Name="InnerDot" Width="8" Height="8" Fill="White" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="White" />
                                </Trigger>
                                <Trigger Property="Tag" Value="Selected">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource OrbitAccentBrush}" />
                                    <Setter TargetName="Border" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="InnerDot" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Work Area (Left Toolbar + Canvas + Right Inspector) -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER BAR -->
        <Border Grid.Row="0" Background="{StaticResource OrbitSurfaceBrush}" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="0,0,0,1" Padding="16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Title & File Badge -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center: Studio Mode Tabs & History / Zoom -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Actions (Copy, Save, Save As) -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Section: Title & Loaded Image Meta -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource OrbitAccentBrush}" Margin="0,0,12,0">
                        <TextBlock Text="◈" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Orbit Image Studio" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="15" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtImageMeta" Text="No image loaded" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Section: Mode Tabs & History / Zoom Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Mode Switcher Tabs -->
                    <Border Background="#16171E" CornerRadius="8" Padding="3" Margin="0,0,16,0" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnModeMarkup" Content="✏ Markup" Tag="Active" Style="{StaticResource OrbitTabButtonStyle}" Click="OnModeTabClicked"/>
                            <Button x:Name="BtnModeAdjust" Content="🎛 Adjust" Style="{StaticResource OrbitTabButtonStyle}" Click="OnModeTabClicked"/>
                            <Button x:Name="BtnModeWatermark" Content="💧 Watermark" Style="{StaticResource OrbitTabButtonStyle}" Click="OnModeTabClicked"/>
                            <Button x:Name="BtnModeTransform" Content="✂ Transform" Style="{StaticResource OrbitTabButtonStyle}" Click="OnModeTabClicked"/>
                        </StackPanel>
                    </Border>

                    <!-- Separator -->
                    <Rectangle Width="1" Height="22" Fill="{StaticResource OrbitBorderBrush}" Margin="0,0,14,0"/>

                    <!-- Undo / Redo -->
                    <Button x:Name="BtnUndo" ToolTip="Undo (Ctrl+Z)" Style="{StaticResource ToolButtonStyle}" Width="32" Height="32" Margin="2,0" IsEnabled="False" Click="OnUndoClicked">
                        <TextBlock Text="↶" FontSize="16" Foreground="{StaticResource OrbitTextPrimaryBrush}"/>
                    </Button>
                    <Button x:Name="BtnRedo" ToolTip="Redo (Ctrl+Y)" Style="{StaticResource ToolButtonStyle}" Width="32" Height="32" Margin="2,0" IsEnabled="False" Click="OnRedoClicked">
                        <TextBlock Text="↷" FontSize="16" Foreground="{StaticResource OrbitTextPrimaryBrush}"/>
                    </Button>

                    <!-- Separator -->
                    <Rectangle Width="1" Height="22" Fill="{StaticResource OrbitBorderBrush}" Margin="12,0"/>

                    <!-- Zoom Controls -->
                    <Button x:Name="BtnZoomOut" ToolTip="Zoom Out" Style="{StaticResource ToolButtonStyle}" Width="30" Height="30" Click="OnZoomOutClicked">
                        <TextBlock Text="−" FontSize="15" FontWeight="Bold" Foreground="{StaticResource OrbitTextPrimaryBrush}"/>
                    </Button>

                    <ComboBox x:Name="CmbZoom" Width="82" Height="30" Margin="4,0"
                              Style="{StaticResource OrbitComboBoxStyle}"
                              VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                        <ComboBoxItem Content="Fit" />
                        <ComboBoxItem Content="50%" />
                        <ComboBoxItem Content="75%" />
                        <ComboBoxItem Content="100%" IsSelected="True"/>
                        <ComboBoxItem Content="125%" />
                        <ComboBoxItem Content="150%" />
                        <ComboBoxItem Content="200%" />
                    </ComboBox>

                    <Button x:Name="BtnZoomIn" ToolTip="Zoom In" Style="{StaticResource ToolButtonStyle}" Width="30" Height="30" Click="OnZoomInClicked">
                        <TextBlock Text="+" FontSize="15" FontWeight="Bold" Foreground="{StaticResource OrbitTextPrimaryBrush}"/>
                    </Button>

                    <Button x:Name="BtnZoomReset" Content="Fit" ToolTip="Zoom to Fit" Style="{StaticResource OrbitSecondaryButtonStyle}" Padding="8,4" Margin="6,0,0,0" Click="OnZoomResetClicked"/>
                </StackPanel>

                <!-- Right Section: Copy, Save, Save As -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnCopyClipboard" Content="📋 Copy" ToolTip="Copy composited image to Clipboard (Ctrl+C)" 
                            Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,8,0" Click="OnCopyClipboardClicked"/>
                    <Button x:Name="BtnSaveQuick" Content="Save" ToolTip="Overwrite original image" 
                            Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,8,0" Click="OnQuickSaveClicked"/>
                    <Button x:Name="BtnSaveAs" Content="💾 Save As..." ToolTip="Export image to disk" 
                            Style="{StaticResource OrbitAccentButtonStyle}" Click="OnSaveAsClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORK AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar Toolbar (Markup Tools) -->
                <ColumnDefinition Width="64" x:Name="ColLeftToolbar"/>
                <!-- Canvas Center -->
                <ColumnDefinition Width="*"/>
                <!-- Right Inspector / Adjustment & Watermark Panel -->
                <ColumnDefinition Width="320" x:Name="ColRightInspector"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR TOOLBAR (MARKUP TOOLS) -->
            <Border Grid.Column="0" Background="{StaticResource OrbitSurfaceBrush}" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="0,0,1,0" Padding="8,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Select Tool -->
                        <Button x:Name="BtnToolSelect" Tag="Active" ToolTip="Select / Move Elements (V)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <TextBlock Text="↖" FontSize="17" FontWeight="Bold"/>
                        </Button>

                        <!-- Freehand Pen (Free Draw) -->
                        <Button x:Name="BtnToolPen" ToolTip="Freehand Pen Draw (P)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <TextBlock Text="✏" FontSize="16" Foreground="#FF7A1A" FontWeight="Bold"/>
                        </Button>

                        <!-- Arrow -->
                        <Button x:Name="BtnToolArrow" ToolTip="Directional Arrow (A)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <TextBlock Text="➔" FontSize="17" Foreground="#EF4444" FontWeight="Bold"/>
                        </Button>

                        <!-- Rectangle -->
                        <Button x:Name="BtnToolRectangle" ToolTip="Rectangle Shape (R)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <TextBlock Text="▭" FontSize="17" FontWeight="Bold"/>
                        </Button>

                        <!-- Circle / Ellipse -->
                        <Button x:Name="BtnToolCircle" ToolTip="Circle Shape (O)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <TextBlock Text="○" FontSize="17" FontWeight="Bold"/>
                        </Button>

                        <!-- Text Callout -->
                        <Button x:Name="BtnToolText" ToolTip="Text Annotation (T)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <TextBlock Text="T" FontSize="16" FontWeight="Bold"/>
                        </Button>

                        <!-- Numbered Step Badge -->
                        <Button x:Name="BtnToolStepBadge" ToolTip="Numbered Step Badge 1, 2, 3... (S)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource OrbitAccentBrush}">
                                <TextBlock Text="①" FontSize="13" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>

                        <Rectangle Height="1" Fill="{StaticResource OrbitBorderBrush}" Margin="4,6"/>

                        <!-- Blur / Pixelate -->
                        <Button x:Name="BtnToolBlur" ToolTip="Blur Sensitive Area (B)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <TextBlock Text="░" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Button>

                        <!-- Highlight -->
                        <Button x:Name="BtnToolHighlight" ToolTip="Highlight (H)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <TextBlock Text="▮" FontSize="17" Foreground="#FACC15"/>
                        </Button>

                        <!-- Redact -->
                        <Button x:Name="BtnToolRedact" ToolTip="Solid Redact Bar (X)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <Border Width="20" Height="8" Background="Black" BorderBrush="#64748B" BorderThickness="1" CornerRadius="1"/>
                        </Button>

                        <Rectangle Height="1" Fill="{StaticResource OrbitBorderBrush}" Margin="4,6"/>

                        <!-- Color Palette Swatches -->
                        <TextBlock Text="COLOR" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                        <Button x:Name="SwatchRed" Background="#EF4444" Tag="Selected" Style="{StaticResource ColorSwatchStyle}" Click="OnColorSwatchClicked" ToolTip="Red"/>
                        <Button x:Name="SwatchOrange" Background="#FF7A1A" Style="{StaticResource ColorSwatchStyle}" Click="OnColorSwatchClicked" ToolTip="Orange"/>
                        <Button x:Name="SwatchYellow" Background="#F59E0B" Style="{StaticResource ColorSwatchStyle}" Click="OnColorSwatchClicked" ToolTip="Yellow"/>
                        <Button x:Name="SwatchGreen" Background="#10B981" Style="{StaticResource ColorSwatchStyle}" Click="OnColorSwatchClicked" ToolTip="Green"/>
                        <Button x:Name="SwatchCyan" Background="#06B6D4" Style="{StaticResource ColorSwatchStyle}" Click="OnColorSwatchClicked" ToolTip="Cyan"/>
                        <Button x:Name="SwatchWhite" Background="#FFFFFF" Style="{StaticResource ColorSwatchStyle}" Click="OnColorSwatchClicked" ToolTip="White"/>
                        <Button x:Name="SwatchBlack" Background="#000000" Style="{StaticResource ColorSwatchStyle}" Click="OnColorSwatchClicked" ToolTip="Black"/>

                        <Rectangle Height="1" Fill="{StaticResource OrbitBorderBrush}" Margin="4,6"/>

                        <!-- Stroke Thickness Button -->
                        <TextBlock Text="SIZE" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                        <Button x:Name="BtnStrokeWidth" Content="4px" ToolTip="Stroke Width (click to cycle 2, 4, 8, 12px)" 
                                Style="{StaticResource ToolButtonStyle}" Width="36" Height="26" FontSize="11" Click="OnStrokeWidthCycleClicked"/>

                        <!-- Delete Selected -->
                        <Button x:Name="BtnDeleteSelected" ToolTip="Delete Selected (Del)" Style="{StaticResource ToolButtonStyle}" Margin="0,6,0,0" Click="OnDeleteSelectedClicked">
                            <TextBlock Text="🗑" FontSize="15" Foreground="#EF4444"/>
                        </Button>

                        <!-- Clear All -->
                        <Button x:Name="BtnClearAll" ToolTip="Clear All Annotations" Style="{StaticResource ToolButtonStyle}" Click="OnClearAllClicked">
                            <TextBlock Text="✕" FontSize="14" Foreground="{StaticResource OrbitTextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CENTER CANVAS AREA -->
            <Grid Grid.Column="1" Background="#111217" AllowDrop="True" Drop="OnCanvasDrop" DragOver="OnCanvasDragOver">
                <ScrollViewer x:Name="ImageScrollViewer" 
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Auto"
                              Background="Transparent"
                              PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                    <Grid x:Name="CanvasContainer" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
                        <!-- Canvas with natural pixel dimensions and scale transform -->
                        <Canvas x:Name="DrawingCanvas"
                                Width="800" Height="600"
                                Background="Transparent"
                                MouseLeftButtonDown="OnCanvasMouseLeftButtonDown"
                                MouseMove="OnCanvasMouseMove"
                                MouseLeftButtonUp="OnCanvasMouseLeftButtonUp">
                            <Canvas.LayoutTransform>
                                <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                            </Canvas.LayoutTransform>

                            <!-- Base Image Render Target -->
                            <Image x:Name="BaseImageElement" Stretch="None"/>

                            <!-- Active Annotation Elements & Watermarks reside as children here -->
                        </Canvas>
                    </Grid>
                </ScrollViewer>

                <!-- Empty State Prompt (shown when no image is loaded) -->
                <Border x:Name="EmptyStatePrompt" 
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource OrbitSurfaceBrush}" 
                        BorderBrush="{StaticResource OrbitBorderBrush}" 
                        BorderThickness="2" CornerRadius="16" 
                        Padding="36,28" MaxWidth="440" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource OrbitAccentSubtleBrush}" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="🖼" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Drag &amp; Drop Image Here" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Supports PNG, JPG, WebP, BMP, GIF, TIFF. Markup with pen, arrows, watermarks, light/contrast tuning, and privacy redaction." 
                                   Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,16"/>
                        <Button Content="Choose Image File..." Style="{StaticResource OrbitAccentButtonStyle}" HorizontalAlignment="Center" Click="OnOpenImageClicked" IsHitTestVisible="True"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT INSPECTOR PANEL (ADJUSTMENTS / WATERMARK / TRANSFORM) -->
            <Border Grid.Column="2" Background="{StaticResource OrbitSurfaceBrush}" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1,0,0,0" Padding="18,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- ==================== TAB 1: MARKUP QUICK CONTROLS ==================== -->
                        <StackPanel x:Name="PnlMarkupDetails" Visibility="Visible">
                            <TextBlock Text="ANNOTATION &amp; MARKUP" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>
                            
                            <Border Background="#16171E" CornerRadius="8" Padding="12" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Active Tool" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock x:Name="TxtActiveToolName" Text="Freehand Pen (Draw freely on image)" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Instructions" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="• Drag to draw or place shapes&#x0a;• Click 'Select' (↖) to move or resize elements&#x0a;• Press Del to delete selected markup&#x0a;• Press P for Pen, A for Arrow, T for Text" 
                                       Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="11" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <Button Content="Switch to Watermark Mode" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,0,8" Click="OnGoToWatermarkClicked"/>
                            <Button Content="Switch to Adjustments Mode" Style="{StaticResource OrbitSecondaryButtonStyle}" Click="OnGoToAdjustClicked"/>
                        </StackPanel>

                        <!-- ==================== TAB 2: ADJUSTMENTS PANEL ==================== -->
                        <StackPanel x:Name="PnlAdjustments" Visibility="Collapsed">
                            <TextBlock Text="LIGHT &amp; COLOR TUNING" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,14"/>

                            <!-- Brightness -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Brightness" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtValBrightness" Text="0" Foreground="{StaticResource OrbitAccentBrush}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderBrightness" Minimum="-100" Maximum="100" Value="0" Style="{StaticResource OrbitSliderStyle}" Margin="0,0,0,16" ValueChanged="OnAdjustmentSliderChanged"/>

                            <!-- Contrast -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Contrast" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtValContrast" Text="0" Foreground="{StaticResource OrbitAccentBrush}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderContrast" Minimum="-100" Maximum="100" Value="0" Style="{StaticResource OrbitSliderStyle}" Margin="0,0,0,16" ValueChanged="OnAdjustmentSliderChanged"/>

                            <!-- Saturation -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Saturation" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtValSaturation" Text="0" Foreground="{StaticResource OrbitAccentBrush}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderSaturation" Minimum="-100" Maximum="100" Value="0" Style="{StaticResource OrbitSliderStyle}" Margin="0,0,0,16" ValueChanged="OnAdjustmentSliderChanged"/>

                            <!-- Blur / Soften -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Blur / Soften" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtValBlur" Text="0" Foreground="{StaticResource OrbitAccentBrush}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderBlur" Minimum="0" Maximum="20" Value="0" Style="{StaticResource OrbitSliderStyle}" Margin="0,0,0,20" ValueChanged="OnAdjustmentSliderChanged"/>

                            <!-- Quick Presets -->
                            <TextBlock Text="One-Click Presets" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <UniformGrid Columns="2" Margin="0,0,0,16">
                                <Button Content="Auto Vivid" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,4,6" Click="OnPresetVividClicked"/>
                                <Button Content="B&amp;W Mono" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="4,0,0,6" Click="OnPresetMonoClicked"/>
                                <Button Content="Sepia Tone" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,4,0" Click="OnPresetSepiaClicked"/>
                                <Button Content="High Contrast" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="4,0,0,0" Click="OnPresetHighContrastClicked"/>
                            </UniformGrid>

                            <!-- Reset Adjustments -->
                            <Button Content="↺ Reset to Defaults" Style="{StaticResource OrbitSecondaryButtonStyle}" Click="OnResetAdjustmentsClicked"/>
                        </StackPanel>

                        <!-- ==================== TAB 3: WATERMARK STUDIO ==================== -->
                        <StackPanel x:Name="PnlWatermark" Visibility="Collapsed">
                            <TextBlock Text="WATERMARK STUDIO" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,14"/>

                            <!-- Watermark Type Radio -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <RadioButton x:Name="RbWatermarkText" Content="Text Watermark" IsChecked="True" Foreground="{StaticResource OrbitTextPrimaryBrush}" Margin="0,0,16,0" Checked="OnWatermarkTypeChanged"/>
                                <RadioButton x:Name="RbWatermarkLogo" Content="Logo Image" Foreground="{StaticResource OrbitTextPrimaryBrush}" Checked="OnWatermarkTypeChanged"/>
                            </StackPanel>

                            <!-- Text Section -->
                            <StackPanel x:Name="SecWatermarkText">
                                <TextBlock Text="Watermark Text" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtWatermarkInput" Text="ORBIT CONFIDENTIAL" Style="{StaticResource OrbitTextBoxStyle}" Margin="0,0,0,12" TextChanged="OnWatermarkInputChanged"/>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Font Size" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12"/>
                                    <TextBlock x:Name="TxtValWatermarkSize" Text="36px" Foreground="{StaticResource OrbitAccentBrush}" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderWatermarkSize" Minimum="12" Maximum="96" Value="36" Style="{StaticResource OrbitSliderStyle}" Margin="0,0,0,12" ValueChanged="OnWatermarkInputChanged"/>
                            </StackPanel>

                            <!-- Logo Section -->
                            <StackPanel x:Name="SecWatermarkLogo" Visibility="Collapsed">
                                <TextBlock Text="Logo Image" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Button Content="Browse Logo Image..." Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,0,8" Click="OnBrowseWatermarkLogoClicked"/>
                                <TextBlock x:Name="TxtWatermarkLogoPath" Text="No logo selected" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Logo Scale" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12"/>
                                    <TextBlock x:Name="TxtValWatermarkScale" Text="40%" Foreground="{StaticResource OrbitAccentBrush}" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderWatermarkScale" Minimum="10" Maximum="100" Value="40" Style="{StaticResource OrbitSliderStyle}" Margin="0,0,0,12" ValueChanged="OnWatermarkInputChanged"/>
                            </StackPanel>

                            <!-- Opacity -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Opacity" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtValWatermarkOpacity" Text="60%" Foreground="{StaticResource OrbitAccentBrush}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderWatermarkOpacity" Minimum="10" Maximum="100" Value="60" Style="{StaticResource OrbitSliderStyle}" Margin="0,0,0,14" ValueChanged="OnWatermarkInputChanged"/>

                            <!-- Placement Position -->
                            <TextBlock Text="Placement Position" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbWatermarkPosition" Style="{StaticResource OrbitComboBoxStyle}" Margin="0,0,0,16" SelectionChanged="OnWatermarkPositionChanged">
                                <ComboBoxItem Content="Bottom-Right" IsSelected="True"/>
                                <ComboBoxItem Content="Bottom-Left"/>
                                <ComboBoxItem Content="Center"/>
                                <ComboBoxItem Content="Top-Right"/>
                                <ComboBoxItem Content="Top-Left"/>
                                <ComboBoxItem Content="Diagonal Tiled"/>
                            </ComboBox>

                            <!-- Actions -->
                            <Button x:Name="BtnApplyWatermark" Content="✓ Apply Watermark to Canvas" Style="{StaticResource OrbitAccentButtonStyle}" Margin="0,0,0,8" Click="OnApplyWatermarkClicked"/>
                            <Button x:Name="BtnRemoveWatermark" Content="Remove Watermark" Style="{StaticResource OrbitSecondaryButtonStyle}" Click="OnRemoveWatermarkClicked"/>
                        </StackPanel>

                        <!-- ==================== TAB 4: TRANSFORM & CROP PANEL ==================== -->
                        <StackPanel x:Name="PnlTransform" Visibility="Collapsed">
                            <TextBlock Text="CROP &amp; ROTATE" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,14"/>

                            <!-- Crop Controls -->
                            <TextBlock Text="Cropping" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Button x:Name="BtnStartCrop" Content="✂ Crop Tool (Drag on canvas)" Style="{StaticResource OrbitAccentButtonStyle}" Margin="0,0,0,8" Click="OnStartCropClicked"/>

                            <TextBlock Text="Aspect Ratio Presets" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="11" Margin="0,6,0,4"/>
                            <UniformGrid Columns="2" Margin="0,0,0,18">
                                <Button Content="Free Aspect" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,4,6" Click="OnAspectPresetClicked" Tag="Free"/>
                                <Button Content="1:1 Square" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="4,0,0,6" Click="OnAspectPresetClicked" Tag="1:1"/>
                                <Button Content="16:9 Wide" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,4,0" Click="OnAspectPresetClicked" Tag="16:9"/>
                                <Button Content="4:3 Standard" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="4,0,0,0" Click="OnAspectPresetClicked" Tag="4:3"/>
                            </UniformGrid>

                            <!-- Rotation & Inversion -->
                            <TextBlock Text="Rotation &amp; Mirror" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <Button Content="↻ 90° CW" ToolTip="Rotate 90 degrees clockwise" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,4,6" Click="OnRotateCWClicked"/>
                                <Button Content="↺ 90° CCW" ToolTip="Rotate 90 degrees counter-clockwise" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="4,0,0,6" Click="OnRotateCCWClicked"/>
                                <Button Content="⇆ Flip Horiz" ToolTip="Mirror horizontally" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,4,0" Click="OnFlipHorizontalClicked"/>
                                <Button Content="⇅ Flip Vert" ToolTip="Invert vertically" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="4,0,0,0" Click="OnFlipVerticalClicked"/>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS FOOTER -->
        <Border Grid.Row="2" Background="{StaticResource OrbitSurfaceBrush}" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatusMessage" Text="Ready" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11"/>
                    <TextBlock Text=" • " Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="11" Margin="4,0"/>
                    <TextBlock x:Name="TxtToolHint" Text="Tool: Pen (Free draw on canvas)" Foreground="{StaticResource OrbitAccentBrush}" FontSize="11"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Shortcuts: P Pen • A Arrow • T Text • S Step • Del Remove • Ctrl+C Copy • Ctrl+Z Undo" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
