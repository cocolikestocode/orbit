<Window x:Class="Orbit.App.Views.ImageAnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Orbit.App.Controls"
        Title="Orbit — Image Studio"
        Height="840" Width="1280"
        MinHeight="640" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Background="{DynamicResource OrbitBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Orbit.App;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Tool Button Style -->
            <Style x:Key="ToolButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource OrbitTextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OrbitSurfaceHoverBrush}" />
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource OrbitBorderBrush}" />
                                </Trigger>
                                <Trigger Property="Tag" Value="Active">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OrbitAccentBrush}" />
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FFA552" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Mini Color Swatch Style -->
            <Style x:Key="ColorSwatchStyle" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="13" 
                                    BorderBrush="#3D4252" 
                                    BorderThickness="1.5">
                                <Ellipse x:Name="InnerDot" Width="8" Height="8" Fill="White" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="White" />
                                </Trigger>
                                <Trigger Property="Tag" Value="Selected">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource OrbitAccentBrush}" />
                                    <Setter TargetName="Border" Property="BorderThickness" Value="2.5" />
                                    <Setter TargetName="InnerDot" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Work Area (Left Toolbar + Canvas + Right Inspector) -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER BAR -->
        <Border Grid.Row="0" Background="{StaticResource OrbitSurfaceBrush}" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Title, File Name & Dirty Status Badge -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center: Studio Mode Tabs & History / Zoom -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Actions (Copy, Save, Save As) -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Section: Title & Dirty State Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource OrbitAccentBrush}" Margin="0,0,10,0">
                        <TextBlock Text="◈" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Orbit Studio" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,8,0"/>
                            <!-- Saved State Badge -->
                            <Border x:Name="BadgeSavedState" Background="#162B21" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="6,2" Visibility="Visible">
                                <TextBlock Text="✓ Saved" Foreground="#10B981" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                            <!-- Unsaved Changes Badge -->
                            <Border x:Name="BadgeUnsavedState" Background="#331D10" BorderBrush="{StaticResource OrbitAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Visibility="Collapsed">
                                <TextBlock Text="● Unsaved Changes" Foreground="{StaticResource OrbitAccentBrush}" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtImageMeta" Text="No image loaded" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Section: Mode Tabs & History / Zoom Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Mode Switcher Tabs -->
                    <Border Background="#16171E" CornerRadius="8" Padding="3" Margin="0,0,14,0" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnModeMarkup" Content="✏ Markup" Tag="Active" Style="{StaticResource OrbitTabButtonStyle}" Click="OnModeTabClicked"/>
                            <Button x:Name="BtnModeAdjust" Content="🎛 Adjust" Style="{StaticResource OrbitTabButtonStyle}" Click="OnModeTabClicked"/>
                            <Button x:Name="BtnModeWatermark" Content="💧 Watermark" Style="{StaticResource OrbitTabButtonStyle}" Click="OnModeTabClicked"/>
                            <Button x:Name="BtnModeTransform" Content="✂ Transform" Style="{StaticResource OrbitTabButtonStyle}" Click="OnModeTabClicked"/>
                        </StackPanel>
                    </Border>

                    <!-- Separator -->
                    <Rectangle Width="1" Height="22" Fill="{StaticResource OrbitBorderBrush}" Margin="0,0,12,0"/>

                    <!-- Undo / Redo -->
                    <Button x:Name="BtnUndo" ToolTip="Undo (Ctrl+Z)" Style="{StaticResource ToolButtonStyle}" Width="32" Height="32" Margin="2,0" IsEnabled="False" Click="OnUndoClicked">
                        <TextBlock Text="↶" FontSize="16" Foreground="{StaticResource OrbitTextPrimaryBrush}"/>
                    </Button>
                    <Button x:Name="BtnRedo" ToolTip="Redo (Ctrl+Y)" Style="{StaticResource ToolButtonStyle}" Width="32" Height="32" Margin="2,0" IsEnabled="False" Click="OnRedoClicked">
                        <TextBlock Text="↷" FontSize="16" Foreground="{StaticResource OrbitTextPrimaryBrush}"/>
                    </Button>

                    <!-- Separator -->
                    <Rectangle Width="1" Height="22" Fill="{StaticResource OrbitBorderBrush}" Margin="12,0"/>

                    <!-- Zoom Controls -->
                    <Button x:Name="BtnZoomOut" ToolTip="Zoom Out (Ctrl+-)" Style="{StaticResource ToolButtonStyle}" Width="30" Height="30" Click="OnZoomOutClicked">
                        <TextBlock Text="−" FontSize="15" FontWeight="Bold" Foreground="{StaticResource OrbitTextPrimaryBrush}"/>
                    </Button>

                    <ComboBox x:Name="CmbZoom" Width="82" Height="30" Margin="4,0"
                              Style="{StaticResource OrbitComboBoxStyle}"
                              VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                        <ComboBoxItem Content="Fit" />
                        <ComboBoxItem Content="50%" />
                        <ComboBoxItem Content="75%" />
                        <ComboBoxItem Content="100%" IsSelected="True"/>
                        <ComboBoxItem Content="125%" />
                        <ComboBoxItem Content="150%" />
                        <ComboBoxItem Content="200%" />
                    </ComboBox>

                    <Button x:Name="BtnZoomIn" ToolTip="Zoom In (Ctrl++)" Style="{StaticResource ToolButtonStyle}" Width="30" Height="30" Click="OnZoomInClicked">
                        <TextBlock Text="+" FontSize="15" FontWeight="Bold" Foreground="{StaticResource OrbitTextPrimaryBrush}"/>
                    </Button>

                    <Button x:Name="BtnZoomReset" Content="Fit" ToolTip="Zoom to Fit" Style="{StaticResource OrbitSecondaryButtonStyle}" Padding="8,4" Margin="6,0,0,0" Click="OnZoomResetClicked"/>
                </StackPanel>

                <!-- Right Section: Copy, Save, Save As -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnCopyClipboard" Content="📋 Copy" ToolTip="Copy composited image to Clipboard (Ctrl+C)" 
                            Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,8,0" Click="OnCopyClipboardClicked"/>
                    <Button x:Name="BtnSaveQuick" Content="💾 Save" ToolTip="Save changes to original file (Ctrl+S)" 
                            Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,8,0" Click="OnQuickSaveClicked"/>
                    <Button x:Name="BtnSaveAs" Content="Export As..." ToolTip="Export image to new file" 
                            Style="{StaticResource OrbitAccentButtonStyle}" Click="OnSaveAsClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORK AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar Toolbar (Markup Tools) -->
                <ColumnDefinition Width="60" x:Name="ColLeftToolbar"/>
                <!-- Canvas Center Area -->
                <ColumnDefinition Width="*"/>
                <!-- Right Dynamic Contextual Inspector Panel -->
                <ColumnDefinition Width="320" x:Name="ColRightInspector"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT TOOLBAR (MARKUP TOOLS) -->
            <Border Grid.Column="0" Background="{StaticResource OrbitSurfaceBrush}" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="0,0,1,0" Padding="6,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Freehand Pen (P) -->
                        <Button x:Name="BtnToolPen" Tag="Active" ToolTip="Freehand Pen / Brush (P)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <TextBlock Text="✏" FontSize="17" Foreground="#FF7A1A" FontWeight="Bold"/>
                        </Button>

                        <!-- Arrow (A) -->
                        <Button x:Name="BtnToolArrow" ToolTip="Callout Arrow (A)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <TextBlock Text="➔" FontSize="17" Foreground="#EF4444" FontWeight="Bold"/>
                        </Button>

                        <!-- Rectangle (R) -->
                        <Button x:Name="BtnToolRectangle" ToolTip="Rectangle Shape (R)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <TextBlock Text="▭" FontSize="17" FontWeight="Bold"/>
                        </Button>

                        <!-- Circle (O) -->
                        <Button x:Name="BtnToolCircle" ToolTip="Circle / Ellipse (O)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <TextBlock Text="○" FontSize="17" FontWeight="Bold"/>
                        </Button>

                        <!-- Text (T) -->
                        <Button x:Name="BtnToolText" ToolTip="Text Callout (T)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <TextBlock Text="T" FontSize="16" FontWeight="Bold"/>
                        </Button>

                        <!-- Numbered Step Badge (S) -->
                        <Button x:Name="BtnToolStepBadge" ToolTip="Numbered Step Badge 1, 2, 3... (S)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource OrbitAccentBrush}">
                                <TextBlock Text="①" FontSize="12" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>

                        <!-- Highlighter (H) -->
                        <Button x:Name="BtnToolHighlight" ToolTip="Translucent Highlighter (H)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <TextBlock Text="▮" FontSize="17" Foreground="#FACC15"/>
                        </Button>

                        <!-- Blur (B) -->
                        <Button x:Name="BtnToolBlur" ToolTip="Blur Sensitive Area (B)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <TextBlock Text="░" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Button>

                        <!-- Redact (X) -->
                        <Button x:Name="BtnToolRedact" ToolTip="Solid Blackout Bar (X)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <Border Width="18" Height="8" Background="Black" BorderBrush="#64748B" BorderThickness="1" CornerRadius="1"/>
                        </Button>

                        <Rectangle Height="1" Fill="{StaticResource OrbitBorderBrush}" Margin="4,6"/>

                        <!-- Select / Move (V) -->
                        <Button x:Name="BtnToolSelect" ToolTip="Select &amp; Move Markup (V)" Style="{StaticResource ToolButtonStyle}" Click="OnToolSelected">
                            <TextBlock Text="↖" FontSize="17" FontWeight="Bold"/>
                        </Button>

                        <Rectangle Height="1" Fill="{StaticResource OrbitBorderBrush}" Margin="4,6"/>

                        <!-- Delete Selected -->
                        <Button x:Name="BtnDeleteSelected" ToolTip="Delete Selected (Del)" Style="{StaticResource ToolButtonStyle}" Click="OnDeleteSelectedClicked">
                            <TextBlock Text="🗑" FontSize="15" Foreground="#EF4444"/>
                        </Button>

                        <!-- Clear All -->
                        <Button x:Name="BtnClearAll" ToolTip="Clear All Annotations" Style="{StaticResource ToolButtonStyle}" Click="OnClearAllClicked">
                            <TextBlock Text="✕" FontSize="14" Foreground="{StaticResource OrbitTextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CENTER CANVAS AREA -->
            <Grid Grid.Column="1" Background="#121318" AllowDrop="True" Drop="OnCanvasDrop" DragOver="OnCanvasDragOver">
                <ScrollViewer x:Name="ImageScrollViewer" 
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Auto"
                              Background="Transparent"
                              PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                    <Grid x:Name="CanvasContainer" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="36">
                        <!-- Canvas with natural pixel dimensions and scale transform -->
                        <Border BorderBrush="#2D313E" BorderThickness="1" CornerRadius="2">
                            <Grid>
                                <Grid.LayoutTransform>
                                    <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                                </Grid.LayoutTransform>

                                <Canvas x:Name="DrawingCanvas"
                                        Width="800" Height="600"
                                        Background="Transparent"
                                        MouseLeftButtonDown="OnCanvasMouseLeftButtonDown"
                                        MouseMove="OnCanvasMouseMove"
                                        MouseLeftButtonUp="OnCanvasMouseLeftButtonUp">
                                    <Canvas.Effect>
                                        <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
                                    </Canvas.Effect>

                                    <!-- Base Image Render Target -->
                                    <Image x:Name="BaseImageElement" Stretch="None"/>

                                    <!-- Active Annotation Elements & Watermarks reside as children here -->
                                </Canvas>

                                <!-- Dedicated Freeform Cropper Layer -->
                                <Canvas x:Name="CropLayerCanvas"
                                        Width="800" Height="600"
                                        Visibility="Collapsed"
                                        Background="Transparent"
                                        ClipToBounds="False"
                                        MouseDown="OnCropLayerMouseDown"
                                        MouseMove="OnCropLayerMouseMove"
                                        MouseUp="OnCropLayerMouseUp">
                                    <!-- 4 Shroud Overlays -->
                                    <Rectangle x:Name="CropShroudTop" Fill="#85000000"/>
                                    <Rectangle x:Name="CropShroudBottom" Fill="#85000000"/>
                                    <Rectangle x:Name="CropShroudLeft" Fill="#85000000"/>
                                    <Rectangle x:Name="CropShroudRight" Fill="#85000000"/>

                                    <!-- Interactive Crop Box with Grid -->
                                    <Border x:Name="CropBoxBorder"
                                            BorderBrush="#FF7A1A"
                                            BorderThickness="2"
                                            Background="#01FFFFFF"
                                            Cursor="SizeAll">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="#40FFFFFF" BorderThickness="0,0,0,1"/>
                                            <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#40FFFFFF" BorderThickness="0,0,0,1"/>
                                            <Border Grid.Column="0" Grid.RowSpan="3" BorderBrush="#40FFFFFF" BorderThickness="0,0,1,0"/>
                                            <Border Grid.Column="1" Grid.RowSpan="3" BorderBrush="#40FFFFFF" BorderThickness="0,0,1,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Corner Handles -->
                                    <Border x:Name="CropHandleTL" Width="14" Height="14" CornerRadius="2" Background="White" BorderBrush="#FF7A1A" BorderThickness="2" Cursor="SizeNWSE"/>
                                    <Border x:Name="CropHandleTR" Width="14" Height="14" CornerRadius="2" Background="White" BorderBrush="#FF7A1A" BorderThickness="2" Cursor="SizeNESW"/>
                                    <Border x:Name="CropHandleBL" Width="14" Height="14" CornerRadius="2" Background="White" BorderBrush="#FF7A1A" BorderThickness="2" Cursor="SizeNESW"/>
                                    <Border x:Name="CropHandleBR" Width="14" Height="14" CornerRadius="2" Background="White" BorderBrush="#FF7A1A" BorderThickness="2" Cursor="SizeNWSE"/>

                                    <!-- Edge Handles -->
                                    <Border x:Name="CropHandleT" Width="24" Height="8" CornerRadius="2" Background="White" BorderBrush="#FF7A1A" BorderThickness="1.5" Cursor="SizeNS"/>
                                    <Border x:Name="CropHandleB" Width="24" Height="8" CornerRadius="2" Background="White" BorderBrush="#FF7A1A" BorderThickness="1.5" Cursor="SizeNS"/>
                                    <Border x:Name="CropHandleL" Width="8" Height="24" CornerRadius="2" Background="White" BorderBrush="#FF7A1A" BorderThickness="1.5" Cursor="SizeWE"/>
                                    <Border x:Name="CropHandleR" Width="8" Height="24" CornerRadius="2" Background="White" BorderBrush="#FF7A1A" BorderThickness="1.5" Cursor="SizeWE"/>

                                    <!-- Floating Crop Action Pill -->
                                    <Border x:Name="CropActionBar" Background="#1E202B" BorderBrush="#3D4052" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.55" Color="#000000"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCropDims" Text="800 × 600 px" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Button Content="✕ Cancel" Width="74" Height="28" Background="#2A2C38" Foreground="#CBD5E1" BorderBrush="#3D4052" BorderThickness="1" FontSize="11" Cursor="Hand" Click="OnCancelCropClicked" Margin="0,0,6,0">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                            </Button>
                                            <Button Content="✓ Apply Crop" Width="96" Height="28" Background="#FF7A1A" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="OnApplyCropClicked">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Canvas>

                                <!-- Dedicated Selection & Resize Handles Overlay -->
                                <Canvas x:Name="SelectionOverlayCanvas"
                                        Width="800" Height="600"
                                        Visibility="Collapsed"
                                        Background="{x:Null}"
                                        ClipToBounds="False">
                                    <!-- Selection Bounding Box -->
                                    <Border x:Name="SelectionBorder"
                                            BorderBrush="#FF7A1A"
                                            BorderThickness="1.5"
                                            Background="#0AEC6D24"
                                            Cursor="SizeAll"
                                            MouseDown="OnSelectionBorderMouseDown"
                                            MouseMove="OnSelectionBorderMouseMove"
                                            MouseUp="OnSelectionBorderMouseUp">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35" Color="#000000"/>
                                        </Border.Effect>
                                    </Border>

                                    <!-- 8 Resize Handles -->
                                    <Ellipse x:Name="HandleTL" Width="10" Height="10" Fill="White" Stroke="#FF7A1A" StrokeThickness="1.8" Cursor="SizeNWSE" MouseDown="OnHandleMouseDown" MouseMove="OnHandleMouseMove" MouseUp="OnHandleMouseUp" Tag="TopLeft"/>
                                    <Ellipse x:Name="HandleTC" Width="10" Height="10" Fill="White" Stroke="#FF7A1A" StrokeThickness="1.8" Cursor="SizeNS" MouseDown="OnHandleMouseDown" MouseMove="OnHandleMouseMove" MouseUp="OnHandleMouseUp" Tag="Top"/>
                                    <Ellipse x:Name="HandleTR" Width="10" Height="10" Fill="White" Stroke="#FF7A1A" StrokeThickness="1.8" Cursor="SizeNESW" MouseDown="OnHandleMouseDown" MouseMove="OnHandleMouseMove" MouseUp="OnHandleMouseUp" Tag="TopRight"/>
                                    <Ellipse x:Name="HandleML" Width="10" Height="10" Fill="White" Stroke="#FF7A1A" StrokeThickness="1.8" Cursor="SizeWE" MouseDown="OnHandleMouseDown" MouseMove="OnHandleMouseMove" MouseUp="OnHandleMouseUp" Tag="Left"/>
                                    <Ellipse x:Name="HandleMR" Width="10" Height="10" Fill="White" Stroke="#FF7A1A" StrokeThickness="1.8" Cursor="SizeWE" MouseDown="OnHandleMouseDown" MouseMove="OnHandleMouseMove" MouseUp="OnHandleMouseUp" Tag="Right"/>
                                    <Ellipse x:Name="HandleBL" Width="10" Height="10" Fill="White" Stroke="#FF7A1A" StrokeThickness="1.8" Cursor="SizeNESW" MouseDown="OnHandleMouseDown" MouseMove="OnHandleMouseMove" MouseUp="OnHandleMouseUp" Tag="BottomLeft"/>
                                    <Ellipse x:Name="HandleBC" Width="10" Height="10" Fill="White" Stroke="#FF7A1A" StrokeThickness="1.8" Cursor="SizeNS" MouseDown="OnHandleMouseDown" MouseMove="OnHandleMouseMove" MouseUp="OnHandleMouseUp" Tag="Bottom"/>
                                    <Ellipse x:Name="HandleBR" Width="10" Height="10" Fill="White" Stroke="#FF7A1A" StrokeThickness="1.8" Cursor="SizeNWSE" MouseDown="OnHandleMouseDown" MouseMove="OnHandleMouseMove" MouseUp="OnHandleMouseUp" Tag="BottomRight"/>
                                </Canvas>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- Empty State Prompt (shown when no image is loaded) -->
                <Border x:Name="EmptyStatePrompt" 
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource OrbitSurfaceBrush}" 
                        BorderBrush="{StaticResource OrbitBorderBrush}" 
                        BorderThickness="2" CornerRadius="16" 
                        Padding="36,28" MaxWidth="440" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource OrbitAccentSubtleBrush}" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="🖼" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Drag &amp; Drop Image Here" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Drop any PNG, JPG, WebP, BMP to edit, annotate, tune, crop, or watermark." 
                                   Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,16"/>
                        <Button Content="Choose Image File..." Style="{StaticResource OrbitAccentButtonStyle}" HorizontalAlignment="Center" Click="OnOpenImageClicked" IsHitTestVisible="True"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT DYNAMIC CONTEXTUAL INSPECTOR PANEL -->
            <Border Grid.Column="2" Background="{StaticResource OrbitSurfaceBrush}" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1,0,0,0" Padding="18,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- ==================== TAB 1: MARKUP CONTEXTUAL INSPECTOR ==================== -->
                        <StackPanel x:Name="PnlMarkupDetails" Visibility="Visible">
                            <TextBlock x:Name="TxtInspectorHeader" Text="PEN &amp; BRUSH PROPERTIES" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,14"/>

                            <!-- Stroke Thickness Slider Section -->
                            <StackPanel x:Name="SecThicknessSlider" Margin="0,0,0,16">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Stroke Thickness" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtValThickness" Text="6 px" Foreground="{StaticResource OrbitAccentBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderThickness" Minimum="1" Maximum="64" Value="6" Style="{StaticResource OrbitSliderStyle}" ValueChanged="OnThicknessSliderChanged"/>

                                <!-- Live Stroke Preview Dot -->
                                <Border Background="#16171E" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1" CornerRadius="8" Height="50" Margin="0,10,0,0">
                                    <Ellipse x:Name="EllipseStrokePreview" Width="6" Height="6" Fill="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Stroke Opacity Slider Section -->
                            <StackPanel x:Name="SecOpacitySlider" Margin="0,0,0,16">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Opacity" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtValOpacity" Text="100%" Foreground="{StaticResource OrbitAccentBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderOpacity" Minimum="10" Maximum="100" Value="100" Style="{StaticResource OrbitSliderStyle}" ValueChanged="OnOpacitySliderChanged"/>
                            </StackPanel>

                            <!-- Numbered Step Badge Section (Shown when Step tool active) -->
                            <StackPanel x:Name="SecStepBadgeOptions" Visibility="Collapsed" Margin="0,0,0,16">
                                <Border Background="#16171E" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Next Badge Number" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11"/>
                                        <TextBlock x:Name="TxtNextBadgeNumber" Text="Badge #1" Foreground="{StaticResource OrbitAccentBrush}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="↺ Reset Counter to 1" Style="{StaticResource OrbitSecondaryButtonStyle}" Click="OnResetBadgeCounterClicked"/>
                            </StackPanel>

                            <!-- Color Palette Grid -->
                            <TextBlock Text="Color Palette" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <WrapPanel Margin="0,0,0,18">
                                <Button x:Name="SwatchRed" Background="#EF4444" Tag="Selected" Style="{StaticResource ColorSwatchStyle}" Click="OnColorSwatchClicked" ToolTip="Red"/>
                                <Button x:Name="SwatchCoral" Background="#FF5722" Style="{StaticResource ColorSwatchStyle}" Click="OnColorSwatchClicked" ToolTip="Coral"/>
                                <Button x:Name="SwatchOrange" Background="#FF7A1A" Style="{StaticResource ColorSwatchStyle}" Click="OnColorSwatchClicked" ToolTip="Orange"/>
                                <Button x:Name="SwatchAmber" Background="#F59E0B" Style="{StaticResource ColorSwatchStyle}" Click="OnColorSwatchClicked" ToolTip="Amber"/>
                                <Button x:Name="SwatchLime" Background="#84CC16" Style="{StaticResource ColorSwatchStyle}" Click="OnColorSwatchClicked" ToolTip="Lime"/>
                                <Button x:Name="SwatchGreen" Background="#10B981" Style="{StaticResource ColorSwatchStyle}" Click="OnColorSwatchClicked" ToolTip="Green"/>
                                <Button x:Name="SwatchCyan" Background="#06B6D4" Style="{StaticResource ColorSwatchStyle}" Click="OnColorSwatchClicked" ToolTip="Cyan"/>
                                <Button x:Name="SwatchBlue" Background="#3B82F6" Style="{StaticResource ColorSwatchStyle}" Click="OnColorSwatchClicked" ToolTip="Blue"/>
                                <Button x:Name="SwatchPurple" Background="#8B5CF6" Style="{StaticResource ColorSwatchStyle}" Click="OnColorSwatchClicked" ToolTip="Purple"/>
                                <Button x:Name="SwatchPink" Background="#EC4899" Style="{StaticResource ColorSwatchStyle}" Click="OnColorSwatchClicked" ToolTip="Pink"/>
                                <Button x:Name="SwatchWhite" Background="#FFFFFF" Style="{StaticResource ColorSwatchStyle}" Click="OnColorSwatchClicked" ToolTip="White"/>
                                <Button x:Name="SwatchBlack" Background="#000000" Style="{StaticResource ColorSwatchStyle}" Click="OnColorSwatchClicked" ToolTip="Black"/>

                                <!-- Custom Color Picker Button -->
                                <Button x:Name="BtnCustomColor" Width="26" Height="26" Margin="3" Cursor="Hand" ToolTip="Custom Color (HEX / RGB)..." Click="OnCustomColorButtonClicked">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Border" CornerRadius="13" BorderBrush="#FF7A1A" BorderThickness="1.5">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#EF4444" Offset="0"/>
                                                        <GradientStop Color="#F59E0B" Offset="0.33"/>
                                                        <GradientStop Color="#10B981" Offset="0.66"/>
                                                        <GradientStop Color="#3B82F6" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </WrapPanel>

                            <!-- Google-Style Visual Color Picker Popup -->
                            <Popup x:Name="PopupColorPicker" PlacementTarget="{Binding ElementName=BtnCustomColor}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <controls:GoogleColorPickerControl x:Name="GoogleColorPicker" 
                                                                   ColorChanged="OnGoogleColorChanged" 
                                                                   ColorApplied="OnGoogleColorApplied" 
                                                                   Closed="OnGoogleColorPickerClosed"/>
                            </Popup>

                            <!-- Tool Quick Switching Hints -->
                            <Border Background="#16171E" CornerRadius="8" Padding="12" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Shortcuts" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="P: Pen • A: Arrow • R: Rect • O: Circle&#x0a;T: Text • S: Step • B: Blur • X: Redact&#x0a;Del: Remove • Ctrl+Z: Undo" 
                                               Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="11" LineHeight="16"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 2: ADJUSTMENTS PANEL ==================== -->
                        <StackPanel x:Name="PnlAdjustments" Visibility="Collapsed">
                            <TextBlock Text="LIGHT &amp; COLOR TUNING" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,14"/>

                            <!-- Brightness -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Brightness" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtValBrightness" Text="0" Foreground="{StaticResource OrbitAccentBrush}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderBrightness" Minimum="-100" Maximum="100" Value="0" Style="{StaticResource OrbitSliderStyle}" Margin="0,0,0,14" ValueChanged="OnAdjustmentSliderChanged"/>

                            <!-- Contrast -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Contrast" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtValContrast" Text="0" Foreground="{StaticResource OrbitAccentBrush}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderContrast" Minimum="-100" Maximum="100" Value="0" Style="{StaticResource OrbitSliderStyle}" Margin="0,0,0,14" ValueChanged="OnAdjustmentSliderChanged"/>

                            <!-- Saturation -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Saturation" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtValSaturation" Text="0" Foreground="{StaticResource OrbitAccentBrush}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderSaturation" Minimum="-100" Maximum="100" Value="0" Style="{StaticResource OrbitSliderStyle}" Margin="0,0,0,14" ValueChanged="OnAdjustmentSliderChanged"/>

                            <!-- Blur / Soften -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Blur / Soften" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtValBlur" Text="0 px" Foreground="{StaticResource OrbitAccentBrush}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderBlur" Minimum="0" Maximum="20" Value="0" Style="{StaticResource OrbitSliderStyle}" Margin="0,0,0,18" ValueChanged="OnAdjustmentSliderChanged"/>

                            <!-- Quick Presets -->
                            <TextBlock Text="One-Click Presets" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <UniformGrid Columns="2" Margin="0,0,0,16">
                                <Button Content="Auto Vivid" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,4,6" Click="OnPresetVividClicked"/>
                                <Button Content="B&amp;W Mono" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="4,0,0,6" Click="OnPresetMonoClicked"/>
                                <Button Content="Sepia Tone" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,4,0" Click="OnPresetSepiaClicked"/>
                                <Button Content="High Contrast" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="4,0,0,0" Click="OnPresetHighContrastClicked"/>
                            </UniformGrid>

                            <!-- Reset Adjustments -->
                            <Button Content="↺ Reset to Defaults" Style="{StaticResource OrbitSecondaryButtonStyle}" Click="OnResetAdjustmentsClicked"/>
                        </StackPanel>

                        <!-- ==================== TAB 3: WATERMARK STUDIO ==================== -->
                        <StackPanel x:Name="PnlWatermark" Visibility="Collapsed">
                            <TextBlock Text="WATERMARK STUDIO" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,14"/>

                            <!-- Watermark Activation Toggle (OFF by default!) -->
                            <Border Background="#16171E" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                <CheckBox x:Name="ChkEnableWatermark" Content="Enable Watermark Overlay" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" IsChecked="False" Checked="OnWatermarkToggleChanged" Unchecked="OnWatermarkToggleChanged"/>
                            </Border>

                            <!-- Watermark Settings (Enabled only when checkbox is checked) -->
                            <StackPanel x:Name="SecWatermarkControls" IsEnabled="False" Opacity="0.5">
                                <!-- Watermark Type Radio -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <RadioButton x:Name="RbWatermarkText" Content="Text Watermark" IsChecked="True" Foreground="{StaticResource OrbitTextPrimaryBrush}" Margin="0,0,16,0" Checked="OnWatermarkTypeChanged"/>
                                    <RadioButton x:Name="RbWatermarkLogo" Content="Logo Image" Foreground="{StaticResource OrbitTextPrimaryBrush}" Checked="OnWatermarkTypeChanged"/>
                                </StackPanel>

                                <!-- Text Section -->
                                <StackPanel x:Name="SecWatermarkText">
                                    <TextBlock Text="Watermark Text" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtWatermarkInput" Text="CONFIDENTIAL" Style="{StaticResource OrbitTextBoxStyle}" Margin="0,0,0,12" TextChanged="OnWatermarkInputChanged"/>

                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Font Size" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12"/>
                                        <TextBlock x:Name="TxtValWatermarkSize" Text="36px" Foreground="{StaticResource OrbitAccentBrush}" FontSize="12" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SliderWatermarkSize" Minimum="12" Maximum="96" Value="36" Style="{StaticResource OrbitSliderStyle}" Margin="0,0,0,12" ValueChanged="OnWatermarkInputChanged"/>
                                </StackPanel>

                                <!-- Logo Section -->
                                <StackPanel x:Name="SecWatermarkLogo" Visibility="Collapsed">
                                    <TextBlock Text="Logo Image" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Button Content="Browse Logo Image..." Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,0,8" Click="OnBrowseWatermarkLogoClicked"/>
                                    <TextBlock x:Name="TxtWatermarkLogoPath" Text="No logo selected" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Logo Scale" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12"/>
                                        <TextBlock x:Name="TxtValWatermarkScale" Text="40%" Foreground="{StaticResource OrbitAccentBrush}" FontSize="12" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SliderWatermarkScale" Minimum="10" Maximum="100" Value="40" Style="{StaticResource OrbitSliderStyle}" Margin="0,0,0,12" ValueChanged="OnWatermarkInputChanged"/>
                                </StackPanel>

                                <!-- Opacity -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Opacity" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtValWatermarkOpacity" Text="60%" Foreground="{StaticResource OrbitAccentBrush}" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderWatermarkOpacity" Minimum="10" Maximum="100" Value="60" Style="{StaticResource OrbitSliderStyle}" Margin="0,0,0,14" ValueChanged="OnWatermarkInputChanged"/>

                                <!-- Placement Position -->
                                <TextBlock Text="Placement Position" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbWatermarkPosition" Style="{StaticResource OrbitComboBoxStyle}" Margin="0,0,0,16" SelectionChanged="OnWatermarkPositionChanged">
                                    <ComboBoxItem Content="Bottom-Right" IsSelected="True"/>
                                    <ComboBoxItem Content="Bottom-Left"/>
                                    <ComboBoxItem Content="Center"/>
                                    <ComboBoxItem Content="Top-Right"/>
                                    <ComboBoxItem Content="Top-Left"/>
                                    <ComboBoxItem Content="Diagonal Tiled"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- ==================== TAB 4: TRANSFORM & CROP PANEL ==================== -->
                        <StackPanel x:Name="PnlTransform" Visibility="Collapsed">
                            <TextBlock Text="CROP &amp; ROTATE" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,14"/>

                            <!-- Crop Controls -->
                            <TextBlock Text="Cropping" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Button x:Name="BtnStartCrop" Content="✂ Crop Tool (Drag on canvas)" Style="{StaticResource OrbitAccentButtonStyle}" Margin="0,0,0,8" Click="OnStartCropClicked"/>

                            <TextBlock Text="Aspect Ratio Presets" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="11" Margin="0,6,0,4"/>
                            <UniformGrid Columns="2" Margin="0,0,0,18">
                                <Button Content="Free Aspect" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,4,6" Click="OnAspectPresetClicked" Tag="Free"/>
                                <Button Content="1:1 Square" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="4,0,0,6" Click="OnAspectPresetClicked" Tag="1:1"/>
                                <Button Content="16:9 Wide" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,4,0" Click="OnAspectPresetClicked" Tag="16:9"/>
                                <Button Content="4:3 Standard" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="4,0,0,0" Click="OnAspectPresetClicked" Tag="4:3"/>
                            </UniformGrid>

                            <!-- Rotation & Inversion -->
                            <TextBlock Text="Rotation &amp; Mirror" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <Button Content="↻ 90° CW" ToolTip="Rotate 90 degrees clockwise" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,4,6" Click="OnRotateCWClicked"/>
                                <Button Content="↺ 90° CCW" ToolTip="Rotate 90 degrees counter-clockwise" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="4,0,0,6" Click="OnRotateCCWClicked"/>
                                <Button Content="⇆ Flip Horiz" ToolTip="Mirror horizontally" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="0,0,4,0" Click="OnFlipHorizontalClicked"/>
                                <Button Content="⇅ Flip Vert" ToolTip="Invert vertically" Style="{StaticResource OrbitSecondaryButtonStyle}" Margin="4,0,0,0" Click="OnFlipVerticalClicked"/>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS FOOTER -->
        <Border Grid.Row="2" Background="{StaticResource OrbitSurfaceBrush}" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatusMessage" Text="Ready" Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11"/>
                    <TextBlock Text=" • " Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="11" Margin="4,0"/>
                    <TextBlock x:Name="TxtToolHint" Text="Tool: Pen (Free draw on canvas)" Foreground="{StaticResource OrbitAccentBrush}" FontSize="11"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Shortcuts: P Pen • A Arrow • R Rect • T Text • S Step • Del Remove • Ctrl+S Save • Ctrl+Z Undo" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
