<Window x:Class="Orbit.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Orbit.App.Controls"
        Title="Orbit Overlay"
        Width="540" Height="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        AllowDrop="True">
    <Grid Width="540" Height="540" Background="#01000000">
        <Grid x:Name="MenuContainer" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="MenuScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
            </Grid.RenderTransform>
            <controls:RadialMenuControl x:Name="RadialMenu" />
        </Grid>
    </Grid>
</Window>
