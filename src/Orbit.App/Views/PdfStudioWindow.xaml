<Window x:Class="Orbit.App.Views.PdfStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit — PDF Studio"
        Height="840" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource OrbitBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Orbit.App;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PdfActionBtn" TargetType="Button">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Background" Value="#232530"/>
                <Setter Property="Foreground" Value="{DynamicResource OrbitTextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="#353746"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2F3242"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7A1A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ThumbnailItemStyle" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8" Padding="6">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF7A1A"/>
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1C2638"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#232532"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content (Thumbnails + Viewer) -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0" Background="#16171E" BorderBrush="#2D303E" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & File Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2B1A14" BorderBrush="#FF7A1A" BorderThickness="1" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="📄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Orbit PDF Studio" Foreground="{DynamicResource OrbitTextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,8,0"/>
                            <Border x:Name="BadgeDirty" Background="#331D10" BorderBrush="#FF7A1A" BorderThickness="1" CornerRadius="6" Padding="6,2" Visibility="Collapsed">
                                <TextBlock Text="● Unsaved Changes" Foreground="#FF7A1A" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtDocMeta" Text="No document loaded" Foreground="{DynamicResource OrbitTextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Page Actions (Rotate, Delete, Move) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource PdfActionBtn}" Content="↶ Rotate Left" Click="OnRotateLeftClicked" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource PdfActionBtn}" Content="↷ Rotate Right" Click="OnRotateRightClicked" Margin="0,0,6,0"/>
                    <Rectangle Width="1" Height="22" Fill="#353746" Margin="8,0"/>
                    <Button Style="{StaticResource PdfActionBtn}" Content="▲ Move Up" Click="OnMoveUpClicked" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource PdfActionBtn}" Content="▼ Move Down" Click="OnMoveDownClicked" Margin="0,0,6,0"/>
                    <Rectangle Width="1" Height="22" Fill="#353746" Margin="8,0"/>
                    <Button Style="{StaticResource PdfActionBtn}" Content="🗑 Delete Page" Click="OnDeletePageClicked" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource PdfActionBtn}" Content="✂ Extract Page" Click="OnExtractPageClicked" Margin="0,0,6,0"/>
                    <Rectangle Width="1" Height="22" Fill="#353746" Margin="8,0"/>
                    <Button Style="{StaticResource PdfActionBtn}" Content="🔒 Protect..." Click="OnProtectClicked" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource PdfActionBtn}" Content="🖼 Export Images" Click="OnExportImagesClicked"/>
                </StackPanel>

                <!-- Right: Save & Export Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PdfActionBtn}" Content="Save As..." Click="OnSaveAsClicked" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSave" Content="Save PDF" Width="100" Height="34" Background="#FF7A1A" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="OnSaveClicked">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar: Pages Thumbnails Strip -->
                <ColumnDefinition Width="260" MinWidth="180" MaxWidth="360"/>
                <ColumnDefinition Width="Auto"/>
                <!-- Center: High-Resolution Page Canvas Viewer -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pages Thumbnail List -->
            <Border Grid.Column="0" Background="#16171E" BorderBrush="#2D303E" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,12" BorderBrush="#262834" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="TxtPagesHeader" Text="Pages (0)" Foreground="{DynamicResource OrbitTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                    </Border>

                    <ListBox Grid.Row="1" x:Name="LbThumbnails" Background="Transparent" BorderThickness="0" Padding="12"
                             ItemContainerStyle="{StaticResource ThumbnailItemStyle}"
                             SelectionChanged="OnThumbnailSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center">
                                    <Border BorderBrush="#353746" BorderThickness="1" CornerRadius="4" Background="White" Width="170" Height="220" ClipToBounds="True">
                                        <Image Source="{Binding Image}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding PageLabel}" Foreground="{DynamicResource OrbitTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#232530"/>

            <!-- Center Viewer Canvas -->
            <Grid Grid.Column="2" Background="#101116">
                <ScrollViewer x:Name="PdfScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <Grid x:Name="ViewerContainer" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
                        <Border BorderBrush="#2D313E" BorderThickness="1" CornerRadius="4" Background="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                            </Border.Effect>
                            <Image x:Name="ActivePageImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- Floating Zoom Bar -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Background="#1E202B" BorderBrush="#353746" BorderThickness="1" CornerRadius="8" Padding="12,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="-" Width="28" Height="28" Background="#282A36" Foreground="{DynamicResource OrbitTextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Click="OnZoomOutClicked">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>
                        <TextBlock x:Name="TxtZoomLevel" Text="100%" Foreground="{DynamicResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0"/>
                        <Button Content="+" Width="28" Height="28" Background="#282A36" Foreground="{DynamicResource OrbitTextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Click="OnZoomInClicked">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>
                        <Rectangle Width="1" Height="18" Fill="#353746" Margin="10,0"/>
                        <Button Content="Fit Page" Height="28" Padding="8,0" Background="#282A36" Foreground="{DynamicResource OrbitTextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Click="OnFitPageClicked">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#16171E" BorderBrush="#2D303E" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{DynamicResource OrbitTextSecondaryBrush}" FontSize="12"/>
                <TextBlock x:Name="TxtCurrentPageInfo" Text="" HorizontalAlignment="Right" Foreground="{DynamicResource OrbitTextSecondaryBrush}" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
