<Window x:Class="Orbit.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit — Settings &amp; Customization"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource OrbitBackgroundBrush}">

    <Window.Resources>
        <!-- Nav Item Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource OrbitTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ActiveBar" Grid.Column="0" Width="3" Height="16" Background="{StaticResource OrbitAccentBrush}" CornerRadius="2" Margin="-8,0,8,0" Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource OrbitSurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource OrbitTextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource OrbitSurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource OrbitTextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Setting Row Style -->
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource OrbitSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrbitBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Key Shortcut Box Style -->
        <Style x:Key="ShortcutKeyBoxStyle" TargetType="TextBox" BasedOn="{StaticResource OrbitTextBoxStyle}">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="32" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource OrbitAccentBrush}" />
            <Setter Property="Background" Value="#171A24" />
            <Setter Property="BorderBrush" Value="#383E54" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="MaxLength" Value="4" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Navigation -->
            <ColumnDefinition Width="220"/>
            <!-- Main Content Section -->
            <ColumnDefinition Width="*"/>
            <!-- Right Sidebar: Menu Preview & Size -->
            <ColumnDefinition Width="310"/>
        </Grid.ColumnDefinitions>

        <!-- 1. LEFT SIDEBAR NAVIGATION -->
        <Border Grid.Column="0" Background="{StaticResource OrbitSurfaceBrush}" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="0,0,1,0" Padding="16,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Logo & Title -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource OrbitAccentBrush}" Margin="0,0,10,0">
                            <TextBlock Text="◎" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <TextBlock Text="ORBIT" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Preferences &amp; Engine Config" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="11" Margin="38,2,0,0"/>
                </StackPanel>

                <!-- Navigation List -->
                <StackPanel Grid.Row="1">
                    <Button x:Name="NavGeneral" Content="⚙️  General" Style="{StaticResource NavButtonStyle}" Click="OnNavGeneralClicked"/>
                    <Button x:Name="NavShortcuts" Content="⌨️  Shortcuts" Tag="Active" Style="{StaticResource NavButtonStyle}" Click="OnNavShortcutsClicked"/>
                    <Button x:Name="NavAppearance" Content="🎨  Appearance" Style="{StaticResource NavButtonStyle}" Click="OnNavAppearanceClicked"/>
                    <Button x:Name="NavFileOps" Content="📁  File Operations" Style="{StaticResource NavButtonStyle}" Click="OnNavFileOpsClicked"/>
                    <Button x:Name="NavIntegrations" Content="🔌  Integrations" Style="{StaticResource NavButtonStyle}" Click="OnNavIntegrationsClicked"/>
                    <Button x:Name="NavAdvanced" Content="🛡️  Advanced" Style="{StaticResource NavButtonStyle}" Click="OnNavAdvancedClicked"/>
                </StackPanel>

                <!-- Version Info -->
                <TextBlock Grid.Row="2" Text="Orbit v0.1.0 • .NET 8" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="10" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 2. MAIN CONTENT SECTION -->
        <Grid Grid.Column="1" Background="{StaticResource OrbitBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
                <StackPanel>
                    <!-- Success Notification Banner -->
                    <Border x:Name="SaveNotificationBanner" Background="#132E27" BorderBrush="#059669" BorderThickness="1" 
                            CornerRadius="8" Padding="14,10" Margin="0,0,0,18" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✓" Foreground="#34D399" FontSize="14" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock Text="Settings saved successfully!" Foreground="#34D399" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>

                    <!-- TAB 2: SHORTCUTS & GESTURE SETTINGS (Primary View) -->
                    <StackPanel x:Name="PanelShortcuts">
                        <!-- Header -->
                        <TextBlock Text="Shortcut &amp; Gesture Settings" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Configure global activation triggers, drag-and-hold gestures, and radial segment hotkeys." 
                                   Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" Margin="0,4,0,20"/>

                        <!-- Activation Gesture Card -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ACTIVATION TRIGGER" Foreground="{StaticResource OrbitAccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>

                                <!-- Activate Orbit ComboBox -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Activate Orbit (Drag + Hold)" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Hold this key while dragging files anywhere in Windows to trigger radial menu." 
                                                   Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbActivationModifier" Grid.Column="1" Width="150" Height="34" 
                                              Style="{StaticResource OrbitComboBoxStyle}"
                                              SelectionChanged="OnActivationModifierChanged">
                                        <ComboBoxItem Content="Shift (Default)" IsSelected="True"/>
                                        <ComboBoxItem Content="Ctrl"/>
                                        <ComboBoxItem Content="Alt"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Activation Hold Delay Slider -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Hold Duration Delay" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Time required to maintain drag before Orbit summons." 
                                                   Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Slider x:Name="SliderHoldDelay" Grid.Column="1" Width="150" Minimum="100" Maximum="500" Value="200" SmallChange="25" 
                                            Style="{StaticResource OrbitSliderStyle}" ValueChanged="OnHoldDelayChanged"/>
                                    <Border Grid.Column="2" Background="#161822" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="10,0,0,0" HorizontalAlignment="Right">
                                        <TextBlock x:Name="TxtHoldDelayValue" Text="200 ms" Foreground="{StaticResource OrbitAccentBrush}" 
                                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Radial Category Shortcuts Card -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="RADIAL CATEGORY HOTKEYS" Foreground="{StaticResource OrbitAccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>
                                <TextBlock Text="Press these keys while holding files to instantly flick into the matching radial category wedge." 
                                           Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="11" Margin="0,0,0,16"/>

                                <!-- Shortcuts Grid (2 columns of key bindings) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Column -->
                                    <StackPanel Grid.Column="0">
                                        <!-- Quick Convert -->
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Quick Convert" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtShortcutConvert" Text="C" HorizontalAlignment="Right" Style="{StaticResource ShortcutKeyBoxStyle}" TextChanged="OnShortcutTextChanged"/>
                                        </Grid>

                                        <!-- Edit -->
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Edit" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtShortcutEdit" Text="E" HorizontalAlignment="Right" Style="{StaticResource ShortcutKeyBoxStyle}" TextChanged="OnShortcutTextChanged"/>
                                        </Grid>

                                        <!-- Annotate -->
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Annotate" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtShortcutAnnotate" Text="A" HorizontalAlignment="Right" Style="{StaticResource ShortcutKeyBoxStyle}" TextChanged="OnShortcutTextChanged"/>
                                        </Grid>

                                        <!-- Optimize -->
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Optimize" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtShortcutOptimize" Text="O" HorizontalAlignment="Right" Style="{StaticResource ShortcutKeyBoxStyle}" TextChanged="OnShortcutTextChanged"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Right Column -->
                                    <StackPanel Grid.Column="2">
                                        <!-- Organize -->
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Organize" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtShortcutOrganize" Text="G" HorizontalAlignment="Right" Style="{StaticResource ShortcutKeyBoxStyle}" TextChanged="OnShortcutTextChanged"/>
                                        </Grid>

                                        <!-- Extract -->
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Extract" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtShortcutExtract" Text="X" HorizontalAlignment="Right" Style="{StaticResource ShortcutKeyBoxStyle}" TextChanged="OnShortcutTextChanged"/>
                                        </Grid>

                                        <!-- Analyze -->
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Analyze" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtShortcutAnalyze" Text="I" HorizontalAlignment="Right" Style="{StaticResource ShortcutKeyBoxStyle}" TextChanged="OnShortcutTextChanged"/>
                                        </Grid>

                                        <!-- Cancel -->
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Cancel" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtShortcutCancel" Text="Esc" HorizontalAlignment="Right" Style="{StaticResource ShortcutKeyBoxStyle}" TextChanged="OnShortcutTextChanged"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 1: GENERAL -->
                    <StackPanel x:Name="PanelGeneral" Visibility="Collapsed">
                        <TextBlock Text="General Settings" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Control startup behavior, taskbar integration, and notifications." Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" Margin="0,4,0,20"/>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="ChkStartup" Content="Launch Orbit automatically at Windows startup" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" Margin="0,0,0,14"/>
                                <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to System Tray instead of closing" IsChecked="True" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" Margin="0,0,0,14"/>
                                <CheckBox x:Name="ChkNotifications" Content="Show Windows notifications upon job completion" IsChecked="True" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" Margin="0,0,0,14"/>
                                <CheckBox x:Name="ChkSounds" Content="Play subtle audio chime when radial canvas summons" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 3: APPEARANCE -->
                    <StackPanel x:Name="PanelAppearance" Visibility="Collapsed">
                        <TextBlock Text="Appearance &amp; Theme" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Customize canvas color palettes, theme mode, and radial menu styling." Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" Margin="0,4,0,20"/>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="THEME MODE" Foreground="{StaticResource OrbitAccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                <ComboBox x:Name="CmbTheme" Width="220" Height="32" HorizontalAlignment="Left" Style="{StaticResource OrbitComboBoxStyle}" Margin="0,0,0,16">
                                    <ComboBoxItem Content="Dark Modern (#181920)" IsSelected="True"/>
                                    <ComboBoxItem Content="Deep OLED (#000000)"/>
                                    <ComboBoxItem Content="Midnight Slate (#0F172A)"/>
                                </ComboBox>

                                <TextBlock Text="ACCENT COLOR" Foreground="{StaticResource OrbitAccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="30" Height="30" CornerRadius="15" Background="#FF7A1A" BorderBrush="White" BorderThickness="2" Margin="0,0,10,0" Cursor="Hand"/>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="#6366F1" Margin="0,0,10,0" Cursor="Hand"/>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="#06B6D4" Margin="0,0,10,0" Cursor="Hand"/>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="#10B981" Margin="0,0,10,0" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 4: FILE OPERATIONS -->
                    <StackPanel x:Name="PanelFileOps" Visibility="Collapsed">
                        <TextBlock Text="File Operations" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Configure output file collision rules and default directories." Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" Margin="0,4,0,20"/>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="ChkPreserveOriginals" Content="Preserve original files by default" IsChecked="True" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" Margin="0,0,0,14"/>
                                <TextBlock Text="OUTPUT DIRECTORY STRATEGY" Foreground="{StaticResource OrbitAccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,4,0,8"/>
                                <ComboBox x:Name="CmbDefaultOutputDir" Width="260" Height="32" HorizontalAlignment="Left" Style="{StaticResource OrbitComboBoxStyle}">
                                    <ComboBoxItem Content="Same folder as source file" IsSelected="True"/>
                                    <ComboBoxItem Content="Subfolder named 'Orbit_Output'"/>
                                    <ComboBoxItem Content="Custom global output directory..."/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 5: INTEGRATIONS -->
                    <StackPanel x:Name="PanelIntegrations" Visibility="Collapsed">
                        <TextBlock Text="Integrations" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Hook into Windows File Explorer, Total Commander, and clipboard." Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" Margin="0,4,0,20"/>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <CheckBox Content="Add 'Open with Orbit' to Windows File Explorer context menu" IsChecked="True" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" Margin="0,0,0,14"/>
                                <CheckBox Content="Enable Drag &amp; Drop interception from third-party file managers" IsChecked="True" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13" Margin="0,0,0,14"/>
                                <CheckBox Content="Auto-detect dragged files from web browser download bar" IsChecked="True" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 6: ADVANCED -->
                    <StackPanel x:Name="PanelAdvanced" Visibility="Collapsed">
                        <TextBlock Text="Advanced Configuration" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Low-level hook parameters, worker threads, and diagnostics." Foreground="{StaticResource OrbitTextSecondaryBrush}" FontSize="12" Margin="0,4,0,20"/>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="MAXIMUM WORKER THREADS" Foreground="{StaticResource OrbitAccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ComboBox Width="160" Height="32" HorizontalAlignment="Left" Style="{StaticResource OrbitComboBoxStyle}" Margin="0,0,0,16">
                                    <ComboBoxItem Content="Auto (4 Threads)" IsSelected="True"/>
                                    <ComboBoxItem Content="2 Threads"/>
                                    <ComboBoxItem Content="4 Threads"/>
                                    <ComboBoxItem Content="8 Threads"/>
                                </ComboBox>
                                <CheckBox Content="Enable verbose diagnostic debug logging to %APPDATA%/Orbit/logs" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 3. RIGHT SIDEBAR: MENU PREVIEW & SIZE -->
        <Border Grid.Column="2" Background="{StaticResource OrbitSurfaceBrush}" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1,0,0,0" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Menu Preview Live Card -->
                    <RowDefinition Height="*"/>
                    <!-- Menu Size Slider -->
                    <RowDefinition Height="Auto"/>
                    <!-- Save Settings Button -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Section Header -->
                <TextBlock Grid.Row="0" Text="Menu Preview" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <!-- Live Miniature Rendering of Orbit Radial Menu -->
                <Border Grid.Row="1" Background="#14151C" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1" 
                        CornerRadius="12" Margin="0,0,0,16" ClipToBounds="True">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="MiniatureMenuScaleTransform" ScaleX="0.9" ScaleY="0.9"/>
                        </Grid.LayoutTransform>

                        <!-- Outer Ambient Glow -->
                        <Ellipse Width="240" Height="240" Fill="#20FF7A1A">
                            <Ellipse.Effect>
                                <BlurEffect Radius="20"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Outer Category Ring Canvas -->
                        <Canvas x:Name="MiniPreviewCanvas" Width="240" Height="240"/>

                        <!-- Central Hub -->
                        <Grid Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="70" Height="70" Fill="#251812" Stroke="#FF7A1A" StrokeThickness="2"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="✕" Foreground="#FFA552" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Cancel" Foreground="#CCCCCC" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Menu Size Slider Control -->
                <Border Grid.Row="2" Background="#1C1E27" BorderBrush="{StaticResource OrbitBorderBrush}" BorderThickness="1" 
                        CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Menu Size" Foreground="{StaticResource OrbitTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtMenuScaleLabel" Text="Medium (100%)" Foreground="{StaticResource OrbitAccentBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>

                        <Slider x:Name="SliderMenuScale" Minimum="0.8" Maximum="1.2" Value="1.0" SmallChange="0.1" 
                                TickFrequency="0.2" IsSnapToTickEnabled="False"
                                ValueChanged="OnMenuScaleValueChanged"/>

                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="Small" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="10" HorizontalAlignment="Left"/>
                            <TextBlock Text="Medium" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Text="Large" Foreground="{StaticResource OrbitTextMutedBrush}" FontSize="10" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Action Buttons: Save & Reset -->
                <StackPanel Grid.Row="3">
                    <Button x:Name="BtnSaveSettings" Content="💾 Save Settings" Style="{StaticResource OrbitAccentButtonStyle}" 
                            Height="38" Margin="0,0,0,8" Click="OnSaveSettingsClicked"/>
                    <Button Content="Reset to Defaults" Style="{StaticResource OrbitSecondaryButtonStyle}" 
                            Height="32" Click="OnResetDefaultsClicked"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
